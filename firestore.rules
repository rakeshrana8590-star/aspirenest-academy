rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "aspirenestplatform@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProgressOwner() {
      return isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    function isExistingProgressOwner() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /students/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId) || isAdmin();

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isOwner(userId)
        && request.resource.data.isPremium == resource.data.isPremium
        && request.resource.data.subscriptionType == resource.data.subscriptionType
        && request.resource.data.premiumStatus == resource.data.premiumStatus;

      allow update: if isAdmin() || isInviteStudentAccessUpdate();
      allow delete: if isAdmin();
    }

    /* ================================
       Learner Profile / Biodata System
       ================================ */

    function isLearnerProfileOwnerExisting(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.normalizedEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        );
    }

    function isLearnerProfileOwnerRequest(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.normalizedEmail == request.auth.token.email ||
          request.resource.data.email == request.auth.token.email
        );
    }

    function studentProfileIdentitySafe() {
      return request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.role == "student" &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function studentProfileCreateKeysOnly() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
        "authProvider",
        "emailVerified",
        "lastLoginAt",
        "profileCompletion",
        "profileMissingFields",
        "profileStatus",
        "source",
        "updatedAt",
        "updatedBy",
        "createdAt",
        "createdBy"
      ]);
    }

    function studentProfileUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
        "authProvider",
        "emailVerified",
        "lastLoginAt",
        "profileCompletion",
        "profileMissingFields",
        "profileStatus",
        "source",
        "updatedAt",
        "updatedBy",
        "createdAt",
        "createdBy"
      ]);
    }

    match /learnerProfiles/{profileId} {
      allow create: if isAdmin() ||
        (
          isLearnerProfileOwnerRequest(profileId) &&
          studentProfileIdentitySafe() &&
          studentProfileCreateKeysOnly()
        );

      allow read: if isAdmin() || isLearnerProfileOwnerExisting(profileId);

      allow update: if isAdmin() ||
        (
          isLearnerProfileOwnerExisting(profileId) &&
          isLearnerProfileOwnerRequest(profileId) &&
          studentProfileIdentitySafe() &&
          studentProfileUpdateKeysOnly()
        );

      allow delete: if isAdmin();
    }

    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    function hasProtectedStudentEntitlement(entitlementId) {
      return isSignedIn() &&
        entitlementId is string &&
        exists(/databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(entitlementId)) &&
        get(/databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(entitlementId)).data.status == "active";
    }

    function hasProtectedPlanEntitlement(planType) {
      return planType == "FREE" ||
        (
          planType == "BASIC" &&
          (
            hasProtectedStudentEntitlement("plan_BASIC") ||
            hasProtectedStudentEntitlement("plan_PREMIUM") ||
            hasProtectedStudentEntitlement("plan_MENTORSHIP")
          )
        ) ||
        (
          planType == "PREMIUM" &&
          (
            hasProtectedStudentEntitlement("plan_PREMIUM") ||
            hasProtectedStudentEntitlement("plan_MENTORSHIP")
          )
        ) ||
        (
          planType == "MENTORSHIP" &&
          hasProtectedStudentEntitlement("plan_MENTORSHIP")
        );
    }

    function canReadProtectedContentAsset() {
      return resource.data.status == "published" &&
        (
          hasProtectedStudentEntitlement(resource.data.requiredEntitlementId) ||
          hasProtectedPlanEntitlement(resource.data.planType)
        );
    }

    match /protectedContentAssets/{assetId} {
      allow read: if isAdmin() || canReadProtectedContentAsset();
      allow create, update, delete: if isAdmin();
    }

    match /contentItems/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /universalContent/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    match /experienceEvents/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /mockResults/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.email == request.auth.token.email;

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.token.email == resource.data.email);

      allow update: if isAdmin() ||
        (
          isSignedIn()
          && resource.data.email == request.auth.token.email
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "testTitle",
            "score",
            "totalMarks",
            "percentage",
            "accuracy",
            "correctCount",
            "wrongCount",
            "skippedCount",
            "totalQuestions",
            "durationSeconds",
            "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    match /mockLeaderboard/{docId} {
      allow read: if true;

      allow create: if isSignedIn()
        && (
          request.resource.data.get("email", "") ==
            request.auth.token.email ||
          request.resource.data.get("studentEmail", "") ==
            request.auth.token.email
        );

      allow update: if isAdmin() ||
        (
          isSignedIn()
          && resource.data.studentEmail == request.auth.token.email
          && request.resource.data.studentEmail ==
            resource.data.studentEmail
          && request.resource.data.leaderboardKey ==
            resource.data.leaderboardKey
          && request.resource.data.testId == resource.data.testId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "testTitle",
            "score",
            "totalMarks",
            "percentage",
            "accuracy",
            "correctCount",
            "wrongCount",
            "skippedCount",
            "totalQuestions",
            "durationSeconds",
            "rankScore",
            "rankTieBreakerScore",
            "attemptId",
            "attemptStartedAt",
            "attemptSubmittedAt",
            "attemptNumber",
            "startedAt",
            "endedAt",
            "updatedAt"
          ])
          && (
            request.resource.data.get("rankScore", 0) >
              resource.data.get("rankScore", 0)
            || (
              request.resource.data.get("rankScore", 0) ==
                resource.data.get("rankScore", 0)
              && request.resource.data.get(
                "rankTieBreakerScore",
                0
              ) >
                resource.data.get("rankTieBreakerScore", 0)
            )
            || (
              resource.data.get("attemptId", "") != ""
              && request.resource.data.get("attemptId", "") ==
                resource.data.get("attemptId", "")
            )
          )
        );

      allow delete: if isAdmin();
    }

    match /questionBank/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /mockQuestions/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notesSubjects/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notesChapters/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /currentAffairs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /payments/{docId} {
      function isPaymentOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      function isNewPaymentOwner() {
        return isSignedIn() && request.resource.data.userId == request.auth.uid;
      }

      function isStudentPaymentCreate() {
        return isNewPaymentOwner() &&
          request.resource.data.keys().hasOnly([
            "orderId",
            "userId",
            "upiLink",
            "studentEmail",
            "studentMobile",
            "studentName",
            "planName",
            "amount",
            "status",
            "studentProof",
            "adminProof",
            "matchStatus",
            "createdAt"
          ]) &&
          request.resource.data.status == "pending_payment" &&
          request.resource.data.studentProof == "" &&
          request.resource.data.adminProof == "" &&
          request.resource.data.matchStatus == "waiting";
      }

      function isStudentProofSubmit() {
        return isPaymentOwner() &&
          resource.data.status in ["pending_payment", "student_proof_submitted"] &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "studentProof",
            "status",
            "updatedAt"
          ]) &&
          request.resource.data.status == "student_proof_submitted" &&
          request.resource.data.studentProof is string &&
          request.resource.data.studentProof.size() > 0;
      }

      allow create: if isAdmin() || isStudentPaymentCreate();

      allow read: if isAdmin() || isPaymentOwner();

      allow update: if isAdmin() || isStudentProofSubmit();

      allow delete: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pricingPlans/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studentActivity/{docId} {
      allow create: if isSignedIn();

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.userId);

      allow update, delete: if isAdmin();
    }

    /* ================================
       AspirePath / Roadmap Studio
       ================================ */

    match /studyRoadmaps/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapDays/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapResourceLinks/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapProgress/{docId} {
      allow create: if isProgressOwner();

      allow read: if isAdmin() || isExistingProgressOwner();

      allow update: if isAdmin() ||
        (
          isExistingProgressOwner() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.roadmapId == resource.data.roadmapId &&
          request.resource.data.dayId == resource.data.dayId
        );

      allow delete: if isAdmin();
    }

    match /studyRoadmapAnalytics/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    /* ================================
       Access Engine
       ================================ */

    function isRedeemEmailMatch(emailValue) {
      return emailValue == request.auth.token.email;
    }

    function isAccessKeyAssignedToRequester() {
      return resource.data.assignedEmail == null ||
        resource.data.assignedEmail == "" ||
        resource.data.assignedEmail == request.auth.token.email;
    }

    function isAccessKeyRedeemUpdate(keyCode) {
      return isSignedIn() &&
        keyCode == resource.data.normalizedCode &&
        resource.data.status == "active" &&
        resource.data.usedCount < resource.data.maxUses &&
        isAccessKeyAssignedToRequester() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "usedCount",
          "status",
          "lastRedeemedByEmail",
          "lastRedeemedByUid",
          "lastRedeemedAt",
          "redeemedByEmail",
          "redeemedByUid",
          "redeemedAt",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.usedCount == resource.data.usedCount + 1 &&
        (
          (
            request.resource.data.usedCount < request.resource.data.maxUses &&
            request.resource.data.status == "active"
          ) ||
          (
            request.resource.data.usedCount >= request.resource.data.maxUses &&
            request.resource.data.status == "used"
          )
        ) &&
        request.resource.data.lastRedeemedByEmail == request.auth.token.email &&
        request.resource.data.lastRedeemedByUid == request.auth.uid &&
        (
          request.resource.data.redeemedByEmail == resource.data.redeemedByEmail ||
          request.resource.data.redeemedByEmail == request.auth.token.email
        ) &&
        (
          request.resource.data.redeemedByUid == resource.data.redeemedByUid ||
          request.resource.data.redeemedByUid == request.auth.uid
        ) &&
        request.resource.data.updatedBy == request.auth.uid;
    }

      function isRedeemDirectKeyAccessMatches(accessKeyId) {
        let key = get(/databases/$(database)/documents/accessKeys/$(accessKeyId)).data;

        return (key.productId == null || key.productId == "") &&
          key.accessUntil != null &&
          key.accessUntil != "" &&
          request.resource.data.productId == key.productId &&
          request.resource.data.course == key.course &&
          request.resource.data.planType == key.planType &&
          request.resource.data.scopeType == key.scopeType &&
          request.resource.data.module == key.module &&
          request.resource.data.itemType == key.itemType &&
          request.resource.data.itemId == key.itemId &&
          request.resource.data.itemIds == key.itemIds &&
          request.resource.data.bundleId == key.bundleId &&
          request.resource.data.accessUntil == key.accessUntil;
      }

      function isRedeemProductAccessMatches(accessKeyId) {
        let key = get(/databases/$(database)/documents/accessKeys/$(accessKeyId)).data;
        let product = get(/databases/$(database)/documents/accessProducts/$(key.productId)).data;

        return key.productId is string &&
          key.productId != "" &&
          exists(/databases/$(database)/documents/accessProducts/$(key.productId)) &&
          product.status == "active" &&
          product.isActive != false &&
          request.resource.data.productId == key.productId &&
          request.resource.data.course == product.course &&
          request.resource.data.planType == product.planType &&
          request.resource.data.scopeType == product.scopeType &&
          request.resource.data.module == product.module &&
          request.resource.data.itemType == product.itemType &&
          request.resource.data.itemId == product.itemId &&
          request.resource.data.itemIds == product.itemIds &&
          product.accessUntil != null &&
          product.accessUntil != "" &&
          request.resource.data.bundleId == product.bundleId &&
          request.resource.data.accessUntil == product.accessUntil;
      }

    function isRedeemStudentAccessCreate() {
      return isSignedIn() &&
        request.resource.data.keys().hasOnly([
          "email",
          "normalizedEmail",
          "uid",
          "planType",
          "scopeType",
          "status",
          "source",
          "course",
          "module",
          "itemType",
          "itemId",
          "itemTitle",
          "itemIds",
          "bundleId",
          "productId",
          "accessKeyId",
          "campaignId",
          "campaignName",
          "campaignSource",
          "learnerName",
          "name",
          "phone",
          "accessFrom",
          "accessUntil",
          "notes",
          "adminNote",
          "updatedAt",
          "createdAt",
          "createdBy",
          "actorEmail"
        ]) &&
        request.resource.data.keys().hasAll([
          "email",
          "normalizedEmail",
          "uid",
          "planType",
          "scopeType",
          "status",
          "source",
          "course",
          "accessKeyId",
          "updatedAt",
          "createdAt",
          "createdBy",
          "actorEmail"
        ]) &&
        request.resource.data.source == "redeem_key" &&
        request.resource.data.status == "active" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.accessKeyId is string &&
        exists(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)) &&
        get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.status == "active" &&
        get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.usedCount <
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.maxUses &&
        (
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.assignedEmail == null ||
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.assignedEmail == "" ||
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.assignedEmail == request.auth.token.email
          ) &&
          (
            isRedeemDirectKeyAccessMatches(request.resource.data.accessKeyId) ||
            isRedeemProductAccessMatches(request.resource.data.accessKeyId)
          );
    }

    function isInviteOwnRecord() {
      return isSignedIn() && (
        resource.data.normalizedEmail == request.auth.token.email ||
        resource.data.email == request.auth.token.email
      );
    }

    function isInviteOpenUpdate(inviteCode) {
      return isInviteOwnRecord() &&
        inviteCode == resource.data.inviteCode &&
        request.time < resource.data.expiresAt &&
        resource.data.inviteStatus in ["pending", "copied", "sent"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "inviteStatus",
          "openedAt",
          "openedByUid",
          "openedByEmail",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.inviteStatus == "opened" &&
        request.resource.data.openedByUid == request.auth.uid &&
        request.resource.data.openedByEmail == request.auth.token.email &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteRedeemUpdate(inviteCode) {
      return isInviteOwnRecord() &&
        inviteCode == resource.data.inviteCode &&
        request.time < resource.data.expiresAt &&
        resource.data.inviteStatus in ["pending", "copied", "sent", "opened"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "inviteStatus",
          "usedAt",
          "redeemedByUid",
          "redeemedByEmail",
          "redeemSource",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.inviteStatus == "used" &&
        request.resource.data.redeemedByUid == request.auth.uid &&
        request.resource.data.redeemedByEmail == request.auth.token.email &&
        request.resource.data.redeemSource == "manual_invite_link" &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteStudentAccessUpdate() {
      return isSignedIn() &&
        (resource.data.normalizedEmail == request.auth.token.email || resource.data.email == request.auth.token.email) &&
        (!resource.data.keys().hasAny(["uid"]) || resource.data.uid == null || resource.data.uid == "" || resource.data.uid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "inviteId",
          "inviteRedeemedAt",
          "inviteRedeemedByUid",
          "inviteRedeemedByEmail",
          "lastInviteRedeemedAt",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.inviteRedeemedByUid == request.auth.uid &&
        request.resource.data.inviteRedeemedByEmail == request.auth.token.email &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteOpenAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "open_access_invite" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "manual_invite_link";
    }

    function isInviteRedeemAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "redeem_access_invite" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "manual_invite_link";
    }

    function isRedeemAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "redeem_access_key" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "redeem_key";
    }

    match /accessProducts/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessKeys/{keyCode} {
      allow read, create, update, delete: if isAdmin();

      allow get: if isSignedIn() &&
        keyCode == resource.data.normalizedCode &&
        isAccessKeyAssignedToRequester();

      allow update: if isAccessKeyRedeemUpdate(keyCode);
    }

    function isStudentEntitlementWrite(uid, entitlementId) {
      return isSignedIn() &&
        uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "id",
          "uid",
          "email",
          "normalizedEmail",
          "accessId",
          "planType",
          "scopeType",
          "module",
          "itemType",
          "itemId",
          "itemIds",
          "bundleId",
          "course",
          "status",
          "source",
          "accessFrom",
          "accessUntil",
          "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "id",
          "uid",
          "email",
          "normalizedEmail",
          "accessId",
          "planType",
          "scopeType",
          "module",
          "itemType",
          "itemId",
          "itemIds",
          "bundleId",
          "course",
          "status",
          "source",
          "accessFrom",
          "accessUntil",
          "updatedAt"
        ]) &&
        request.resource.data.id == entitlementId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.accessId is string &&
        exists(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)) &&
        (
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.normalizedEmail == request.auth.token.email ||
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.email == request.auth.token.email
        ) &&
        request.resource.data.planType ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.planType &&
        request.resource.data.scopeType ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.scopeType &&
        request.resource.data.module ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.module &&
        request.resource.data.itemType ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.itemType &&
        request.resource.data.itemId ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.itemId &&
        request.resource.data.itemIds ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.itemIds &&
        request.resource.data.bundleId ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.bundleId &&
        request.resource.data.course ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.course &&
        request.resource.data.status ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.status &&
        request.resource.data.source ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.source &&
        request.resource.data.accessUntil ==
          get(/databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)).data.accessUntil;
    }

    match /studentAccess/{docId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          (
            resource.data.uid == request.auth.uid ||
            resource.data.normalizedEmail == request.auth.token.email ||
            resource.data.email == request.auth.token.email
          )
        );

      allow create: if isAdmin() || isRedeemStudentAccessCreate();
      allow update: if isAdmin() || isInviteStudentAccessUpdate();
      allow delete: if isAdmin();
    }
    match /studentEntitlements/{uid}/items/{entitlementId} {
      allow read: if isAdmin() || (isSignedIn() && uid == request.auth.uid);
      allow create, update: if isAdmin() || isStudentEntitlementWrite(uid, entitlementId);
      allow delete: if isAdmin();
    }

    match /accessInvites/{docId} {
      allow read: if isAdmin() || isInviteOwnRecord();
      allow create: if isAdmin();
      allow update: if isAdmin() || isInviteOpenUpdate(docId) || isInviteRedeemUpdate(docId);
      allow delete: if isAdmin();
    }

    match /accessAuditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isRedeemAuditCreate() || isInviteOpenAuditCreate() || isInviteRedeemAuditCreate();
      allow update, delete: if false;
    }

    /* ================================
       Access Engine — Future Admin Workflows
       ================================ */

    match /accessBulkImports/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessBulkImportRows/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessEmailQueue/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessNotifications/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessPlanHistory/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /accessActionLogs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
