        "mentorName",
        "mentorAssignmentStatus",
        "mentorAssignedAt",
        "mentorAssignmentSource",
        "updatedAt",
        "updatedBy",
        "createdAt",
        "createdBy"
      ]);
    }

    function studentProfileUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
        "authProvider",
        "emailVerified",
        "lastLoginAt",
        "profileCompletion",
        "profileMissingFields",
