rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function roleAuthorityPath(uid) {
      return /databases/$(database)/documents/roleAuthorities/$(uid);
    }

    function hasRoleAuthority(uid) {
      return exists(roleAuthorityPath(uid));
    }

    function roleAuthorityIsOperational(uid) {
      let authorityPath = roleAuthorityPath(uid);
      let authority = get(authorityPath).data;
      return authority.get("uid", "") == uid &&
        authority.get("accountStatus", "") == "active" &&
        request.auth.token.get("auth_time", 0) >
          authority.get("tokensValidAfterSeconds", 0);
    }

    function isSignedIn() {
      return isAuthenticated() &&
        (
          !hasRoleAuthority(request.auth.uid) ||
          roleAuthorityIsOperational(request.auth.uid)
        );
    }

    function hasDynamicRoleClaim(roleName) {
      return isAuthenticated() &&
        request.auth.token.get("aspirenestRole", "") == roleName &&
        request.auth.token.get("aspirenestAccountStatus", "") == "active" &&
        request.auth.token.get("aspirenestAuthorityVersion", 0) > 0;
    }

    function dynamicRoleAuthorityMatches(roleName) {
      let authority = get(roleAuthorityPath(request.auth.uid)).data;
      return authority.get("uid", "") == request.auth.uid &&
        authority.get("role", "") == roleName &&
        authority.get("accountStatus", "") == "active" &&
        request.auth.token.get("auth_time", 0) >
          authority.get("tokensValidAfterSeconds", 0) &&
        request.auth.token.get("aspirenestAuthorityVersion", 0) ==
          authority.get("authorityVersion", 0);
    }

    function hasTrustedDynamicRole(roleName) {
      return hasDynamicRoleClaim(roleName) &&
        dynamicRoleAuthorityMatches(roleName);
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (
            request.auth.token.email == "aspirenestplatform@gmail.com" &&
            isSignedIn()
          ) ||
          hasTrustedDynamicRole("admin")
        );
    }

    function isOwner(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId &&
        isSignedIn();
    }

    function isDesignatedMentor() {
      return isAuthenticated() &&
        request.auth.token.email == "dr.varshamaru@gmail.com" &&
        isSignedIn();
    }

    /* ================================
       Mentor Assignment Engine — Phase 12
       Mentor role is separate from the Mentor-Guided commercial plan.
       Assigned-student ownership is exact and deny-by-default.
       ================================ */

    function isActiveMentor() {
      return isDesignatedMentor() ||
        hasTrustedDynamicRole("mentor") ||
        (
          isSignedIn() &&
          exists(
            /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)
          ) &&
          get(
            /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)
          ).data.mentorUid == request.auth.uid &&
          get(
            /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)
          ).data.role == "mentor" &&
          get(
            /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)
          ).data.status == "active"
        );
    }

    function isAssignedMentor(studentUid) {
      return isActiveMentor() &&
        studentUid is string &&
        studentUid != "" &&
        exists(
          /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)/students/$(studentUid)
        ) &&
        get(
          /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)/students/$(studentUid)
        ).data.mentorUid == request.auth.uid &&
        get(
          /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)/students/$(studentUid)
        ).data.studentUid == studentUid &&
        get(
          /databases/$(database)/documents/mentorProfiles/$(request.auth.uid)/students/$(studentUid)
        ).data.status == "active";
    }

    function isSafeMentorCanonicalRoute(value) {
      return value is string &&
        value.size() >= 2 &&
        value.size() <= 500 &&
        value.matches("^/[^/].*");
    }

    function mentorRequiredPlanRank(planCode) {
      return planCode == "MENTORSHIP" ? 3 :
        planCode == "PREMIUM" ? 2 :
        planCode == "BASIC" ? 1 :
        0;
    }

    function isActiveMentorAssignmentEntitlement(entitlement, data) {
      let accessFrom = entitlement.get("accessFrom", null);
      let accessUntil = entitlement.get("accessUntil", null);
      let noExpiry = entitlement.get("noExpiry", false) == true;
      let untilManualChange = entitlement.get("untilManualChange", false) == true;
      let scopeType = entitlement.get("scopeType", "plan");
      let planCode = entitlement.get(
        "planCode",
        entitlement.get("planType", "FREE")
      );
      let moduleKey = entitlement.get("module", "");
      let itemType = entitlement.get("itemType", "");
      let itemId = entitlement.get("itemId", "");
      let itemIds = entitlement.get("itemIds", []);

      return entitlement.get("uid", "") == data.studentUid &&
        entitlement.get("status", "") == "active" &&
        (
          accessFrom == null ||
          (accessFrom is timestamp && accessFrom <= request.time)
        ) &&
        (
          noExpiry ||
          untilManualChange ||
          (accessUntil is timestamp && accessUntil > request.time)
        ) &&
        (
          (
            scopeType == "item" &&
            moduleKey == data.moduleKey &&
            itemType == data.itemType &&
            itemId == data.resourceId
          ) ||
          (
            scopeType == "bundle" &&
            itemIds is list &&
            itemIds.hasAny([data.resourceId]) &&
            (moduleKey == "" || moduleKey == data.moduleKey)
          ) ||
          (
            scopeType == "module" &&
            moduleKey == data.moduleKey &&
            mentorRequiredPlanRank(planCode) >=
              mentorRequiredPlanRank(data.requiredPlan)
          ) ||
          (
            scopeType == "plan" &&
            mentorRequiredPlanRank(planCode) >=
              mentorRequiredPlanRank(data.requiredPlan)
          )
        );
    }

    function isValidProtectedMentorAssignmentAccessProof(data) {
      let entitlementPath = /databases/$(database)/documents/studentEntitlements/$(data.studentUid)/items/$(data.matchedGrantId);
      return exists(entitlementPath) &&
        isActiveMentorAssignmentEntitlement(
          get(entitlementPath).data,
          data
        );
    }

    function isValidMentorAssignmentAccessProof(data) {
      return (
        data.requiredPlan == "FREE" &&
        data.matchedGrantId == ""
      ) ||
      (
        data.requiredPlan in ["BASIC", "PREMIUM", "MENTORSHIP"] &&
        data.matchedGrantId is string &&
        data.matchedGrantId != "" &&
        isValidProtectedMentorAssignmentAccessProof(data)
      );
    }

    function isMentorAssignmentParticipant(data) {
      return isSignedIn() &&
        (
          data.studentUid == request.auth.uid ||
          (
            data.mentorUid == request.auth.uid &&
            isAssignedMentor(data.studentUid)
          )
        );
    }

    function isValidMentorAssignmentCreate(assignmentId) {
      let data = request.resource.data;
      return isActiveMentor() &&
        data.keys().hasOnly([
          "assignmentId",
          "mentorUid",
          "studentUid",
          "studentName",
          "resourceId",
          "resourceType",
          "moduleKey",
          "itemType",
          "title",
          "canonicalRoute",
          "requiredPlan",
          "accessState",
          "matchedGrantId",
          "status",
          "dueAt",
          "objective",
          "completedAt",
          "reviewedAt",
          "feedbackCount",
          "createdAt",
          "updatedAt"
        ]) &&
        data.assignmentId == assignmentId &&
        data.mentorUid == request.auth.uid &&
        isAssignedMentor(data.studentUid) &&
        data.studentName is string &&
        data.studentName.size() <= 200 &&
        data.resourceId is string &&
        data.resourceId != "" &&
        data.resourceId.size() <= 240 &&
        data.resourceType is string &&
        data.resourceType in [
          "notes",
          "video",
          "live",
          "mockTest",
          "currentAffairs",
          "roadmap"
        ] &&
        data.moduleKey is string &&
        data.moduleKey != "" &&
        data.itemType is string &&
        data.itemType != "" &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 500 &&
        isSafeMentorCanonicalRoute(data.canonicalRoute) &&
        data.requiredPlan in ["FREE", "BASIC", "PREMIUM", "MENTORSHIP"] &&
        data.accessState in ["HAS_ACCESS", "ACCESS_EXPIRES_SOON"] &&
        isValidMentorAssignmentAccessProof(data) &&
        data.status == "assigned" &&
        (data.dueAt == null || data.dueAt is timestamp) &&
        data.objective is string &&
        data.objective.size() <= 1000 &&
        data.completedAt == null &&
        data.reviewedAt == null &&
        data.feedbackCount == 0 &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isValidMentorAssignmentUpdate() {
      return isActiveMentor() &&
        resource.data.mentorUid == request.auth.uid &&
        isAssignedMentor(resource.data.studentUid) &&
        request.resource.data.assignmentId == resource.data.assignmentId &&
        request.resource.data.mentorUid == resource.data.mentorUid &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.resourceId == resource.data.resourceId &&
        request.resource.data.resourceType == resource.data.resourceType &&
        request.resource.data.moduleKey == resource.data.moduleKey &&
        request.resource.data.itemType == resource.data.itemType &&
        request.resource.data.canonicalRoute == resource.data.canonicalRoute &&
        request.resource.data.requiredPlan == resource.data.requiredPlan &&
        request.resource.data.accessState == resource.data.accessState &&
        request.resource.data.matchedGrantId == resource.data.matchedGrantId &&
        request.resource.data.status in [
          "assigned",
          "in_progress",
          "completed",
          "reviewed",
          "cancelled"
        ] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "dueAt",
          "objective",
          "reviewedAt",
          "feedbackCount",
          "updatedAt"
        ]) &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidStudentAssignmentComplete() {
      return isSignedIn() &&
        resource.data.studentUid == request.auth.uid &&
        resource.data.status in ["assigned", "in_progress"] &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.mentorUid == resource.data.mentorUid &&
        request.resource.data.status == "completed" &&
        request.resource.data.completedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "completedAt",
          "updatedAt"
        ]);
    }

    function isValidMentorAccessRequestCreate(requestId) {
      let data = request.resource.data;
      return isActiveMentor() &&
        data.keys().hasOnly([
          "requestId",
          "mentorUid",
          "studentUid",
          "resourceId",
          "resourceType",
          "moduleKey",
          "itemType",
          "title",
          "canonicalRoute",
          "status",
          "reason",
          "requestedScope",
          "requestTarget",
          "accessId",
          "resolvedAt",
          "resolvedBy",
          "createdAt",
          "updatedAt"
        ]) &&
        data.requestId == requestId &&
        data.mentorUid == request.auth.uid &&
        isAssignedMentor(data.studentUid) &&
        data.resourceId is string &&
        data.resourceId != "" &&
        data.resourceType in [
          "notes",
          "video",
          "live",
          "mockTest",
          "currentAffairs",
          "roadmap"
        ] &&
        data.moduleKey is string &&
        data.moduleKey != "" &&
        data.itemType is string &&
        data.itemType != "" &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 500 &&
        isSafeMentorCanonicalRoute(data.canonicalRoute) &&
        data.status == "pending" &&
        data.reason is string &&
        data.reason.size() <= 1000 &&
        data.get("requestedScope", "ITEM") in ["ITEM", "MODULE", "BUNDLE", "PLAN"] &&
        data.get("requestTarget", data.resourceId) is string &&
        data.accessId == null &&
        data.resolvedAt == null &&
        data.resolvedBy == null &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isMentorAccessRequestParticipant(data) {
      return isSignedIn() &&
        (
          data.studentUid == request.auth.uid ||
          (
            data.mentorUid == request.auth.uid &&
            isAssignedMentor(data.studentUid)
          )
        );
    }

    function isValidMentorFeedbackCreate(feedbackId) {
      let data = request.resource.data;
      let assignmentPath = /databases/$(database)/documents/mentorAssignments/$(data.assignmentId);
      return isActiveMentor() &&
        data.keys().hasOnly([
          "feedbackId",
          "assignmentId",
          "mentorUid",
          "studentUid",
          "message",
          "status",
          "createdAt",
          "updatedAt"
        ]) &&
        data.feedbackId == feedbackId &&
        data.mentorUid == request.auth.uid &&
        isAssignedMentor(data.studentUid) &&
        data.assignmentId is string &&
        data.assignmentId != "" &&
        exists(assignmentPath) &&
        get(assignmentPath).data.mentorUid == request.auth.uid &&
        get(assignmentPath).data.studentUid == data.studentUid &&
        data.message is string &&
        data.message.size() >= 1 &&
        data.message.size() <= 4000 &&
        data.status == "published" &&
        data.createdAt == request.time &&
        data.updatedAt == request.time;
    }

    function isMentorFeedbackParticipant(data) {
      return isSignedIn() &&
        (
          data.studentUid == request.auth.uid ||
          (
            data.mentorUid == request.auth.uid &&
            isAssignedMentor(data.studentUid)
          )
        );
    }

    /* ================================
       IntelliText Admin Authoring + Published Graph — Phase 8B-5
       DIRECT_STUDENT_DRAFT_READ=DENIED
       Published reads require explicit publicRead or one active entitlement.
       ================================ */

    function isValidLearningTextAccessMap(access) {
      return access is map &&
        access.keys().hasOnly([
          "publicRead",
          "readEntitlementIds",
          "requiredPlanCode"
        ]) &&
        access.publicRead is bool &&
        access.readEntitlementIds is list &&
        access.readEntitlementIds.size() <= 6 &&
        (
          access.requiredPlanCode == null ||
          access.requiredPlanCode is string
        );
    }

    function isActiveLearningTextEntitlementData(data) {
      let accessFrom = data.get("accessFrom", null);
      let accessUntil = data.get("accessUntil", null);
      let noExpiry = data.get("noExpiry", false) == true;
      let untilManualChange = data.get("untilManualChange", false) == true;
      return data.status == "active" &&
        (
          accessFrom == null ||
          (accessFrom is timestamp && accessFrom <= request.time)
        ) &&
        (
          noExpiry ||
          untilManualChange ||
          (accessUntil is timestamp && accessUntil > request.time)
        );
    }

    function hasActiveLearningTextEntitlement(entitlementId) {
      let entitlementPath = /databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(entitlementId);
      return entitlementId is string &&
        entitlementId.size() >= 1 &&
        entitlementId.size() <= 128 &&
        exists(entitlementPath) &&
        isActiveLearningTextEntitlementData(
          get(entitlementPath).data
        );
    }

    function hasValidLearningTextEntitlement(data) {
      let ids = data.access.readEntitlementIds;
      return isSignedIn() &&
        ids.size() >= 1 &&
        ids.size() <= 6 &&
        (
          (ids.size() > 0 && hasActiveLearningTextEntitlement(ids[0])) ||
          (ids.size() > 1 && hasActiveLearningTextEntitlement(ids[1])) ||
          (ids.size() > 2 && hasActiveLearningTextEntitlement(ids[2])) ||
          (ids.size() > 3 && hasActiveLearningTextEntitlement(ids[3])) ||
          (ids.size() > 4 && hasActiveLearningTextEntitlement(ids[4])) ||
          (ids.size() > 5 && hasActiveLearningTextEntitlement(ids[5]))
        );
    }

    function isPublishedLearningTextReadable(data, textbookId) {
      return data.textbookId == textbookId &&
        data.resourceType == "NOTE" &&
        data.deliveryMode == "NATIVE_TEXT" &&
        data.publicationState == "PUBLISHED" &&
        data.nativeReady == true &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        isValidLearningTextAccessMap(data.access) &&
        (
          data.access.publicRead == true ||
          hasValidLearningTextEntitlement(data)
        );
    }

    match /learningTexts/{textbookId} {
      allow get: if isAdmin() ||
        isPublishedLearningTextReadable(resource.data, textbookId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /authoringVersions/{versionId} {
        allow read, write: if isAdmin();

        match /sections/{sectionId} {
          allow read, write: if isAdmin();

          match /blocks/{blockId} {
            allow read, write: if isAdmin();
          }
        }
      }

      match /sections/{sectionId} {
        allow get, list: if isAdmin() ||
          isPublishedLearningTextReadable(
            get(
              /databases/$(database)/documents/learningTexts/$(textbookId)
            ).data,
            textbookId
          );
        allow create, update, delete: if isAdmin();

        match /blocks/{blockId} {
          allow get, list: if isAdmin() ||
            isPublishedLearningTextReadable(
              get(
                /databases/$(database)/documents/learningTexts/$(textbookId)
              ).data,
              textbookId
            );
          allow create, update, delete: if isAdmin();
        }
      }
    }

    function isProgressOwner() {
      return isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    function isExistingProgressOwner() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    function isSafeStudentSelfCreate(studentUid) {
      return isSignedIn() &&
        studentUid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.role == "student" &&
        request.resource.data.get("accountStatus", "active") == "active" &&
        request.resource.data.get("emailVerified", request.auth.token.get("email_verified", false)) ==
          request.auth.token.get("email_verified", false) &&
        !request.resource.data.keys().hasAny([
          "allowedRoles",
          "activeRole",
          "planType",
          "subscriptionType",
          "isPremium",
          "entitlements"
        ]);
    }

    function isSafeStudentSelfStatusUpdate(studentUid) {
      return isSignedIn() &&
        studentUid == request.auth.uid &&
        request.resource.data.get("uid", "") == request.auth.uid &&
        request.resource.data.get("email", "") == request.auth.token.email &&
        request.resource.data.get("normalizedEmail", "") == request.auth.token.email &&
        request.resource.data.get("role", "") == "student" &&
        request.resource.data.get("emailVerified", false) == resource.data.get("emailVerified", false) &&
        request.resource.data.get("accountStatus", "active") == resource.data.get("accountStatus", "active") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "email",
          "normalizedEmail",
          "role",
          "lastLoginAt",
          "updatedAt"
        ]);
    }

    match /students/{docId} {
      allow create: if isAdmin() || isSafeStudentSelfCreate(docId);
      allow read: if isAdmin() || isOwner(docId);
      allow update: if isAdmin() || isSafeStudentSelfStatusUpdate(docId);
      allow delete: if isAdmin();
    }

    /* ================================
       IntelliText Private Study Workspace — Phase 8B-4
       Authenticated UID owner-only; no admin or mentor bypass.
       ================================ */

    function isStudentLearningOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidStudyId(value) {
      return value is string &&
        value.size() >= 1 &&
        value.size() <= 128 &&
        value.matches("^[A-Za-z0-9_-]+$");
    }

    function isValidPrivateSelectionAnchor(anchor) {
      return anchor is map &&
        anchor.keys().hasOnly([
          "exactText",
          "prefix",
          "suffix",
          "startOffset",
          "endOffset"
        ]) &&
        anchor.keys().size() == 5 &&
        anchor.exactText is string &&
        anchor.exactText.size() >= 1 &&
        anchor.exactText.size() <= 2000 &&
        anchor.prefix is string &&
        anchor.prefix.size() <= 128 &&
        anchor.suffix is string &&
        anchor.suffix.size() <= 128 &&
        anchor.startOffset is int &&
        anchor.startOffset >= 0 &&
        anchor.endOffset is int &&
        anchor.endOffset > anchor.startOffset;
    }

    function isValidPrivateAnnotationData(uid, annotationId, data) {
      return data.keys().hasOnly([
          "schemaVersion",
          "annotationId",
          "uid",
          "textbookId",
          "sectionId",
          "blockId",
          "contentVersion",
          "type",
          "state",
          "shareState",
          "selectionAnchor",
          "body",
          "createdAt",
          "updatedAt"
        ]) &&
        data.keys().size() == 14 &&
        data.schemaVersion == 1 &&
        data.annotationId == annotationId &&
        data.uid == uid &&
        isValidStudyId(data.annotationId) &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.sectionId) &&
        isValidStudyId(data.blockId) &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        data.type in ["HIGHLIGHT", "UNDERLINE", "NOTE", "DOUBT"] &&
        data.state in ["ACTIVE", "RESOLVED"] &&
        data.shareState == "PRIVATE" &&
        isValidPrivateSelectionAnchor(data.selectionAnchor) &&
        data.body is string &&
        data.body.size() <= 4000 &&
        (
          !(data.type in ["NOTE", "DOUBT"]) ||
          data.body.size() >= 1
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateAnnotationCreate(uid, annotationId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateAnnotationData(
          uid,
          annotationId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateAnnotationUpdate(uid, annotationId) {
      return isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateAnnotationData(
          uid,
          annotationId,
          request.resource.data
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "body",
          "state",
          "updatedAt"
        ]) &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateBookmarkData(uid, bookmarkId, data) {
      return data.keys().hasOnly([
          "schemaVersion",
          "bookmarkId",
          "uid",
          "textbookId",
          "sectionId",
          "blockId",
          "contentVersion",
          "shareState",
          "label",
          "createdAt",
          "updatedAt"
        ]) &&
        data.keys().size() == 11 &&
        data.schemaVersion == 1 &&
        data.bookmarkId == bookmarkId &&
        data.uid == uid &&
        isValidStudyId(data.bookmarkId) &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.sectionId) &&
        isValidStudyId(data.blockId) &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        data.shareState == "PRIVATE" &&
        data.label is string &&
        data.label.size() <= 300 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateBookmarkCreate(uid, bookmarkId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateBookmarkData(
          uid,
          bookmarkId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateBookmarkUpdate(uid, bookmarkId) {
      return isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateBookmarkData(
          uid,
          bookmarkId,
          request.resource.data
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "label",
          "updatedAt"
        ]) &&
        request.resource.data.updatedAt == request.time;
    }


    /* ================================
       IntelliText Preparation + Revision — Phase 8B-6
       Private UID owner-only; no admin or mentor bypass.
       Flashcard creation is atomically coupled to one revision queue item.
       ================================ */

    function isValidRevisionText(value, maximum) {
      return value is string &&
        value.size() >= 1 &&
        value.size() <= maximum;
    }

    function isValidOptionalRevisionLabel(value) {
      return value is string && value.size() <= 300;
    }

    function isValidFlashcardSourceKind(value) {
      return value in ["SELECTION", "ANNOTATION", "MANUAL"];
    }

    function isValidRevisionSourceKind(value) {
      return value in ["FLASHCARD", "SELECTION"];
    }

    function isValidFlashcardState(value) {
      return value in ["ACTIVE", "ARCHIVED"];
    }

    function isValidRevisionState(value) {
      return value in ["ACTIVE", "PAUSED", "MASTERED", "ARCHIVED"];
    }

    function isValidRecallRating(value) {
      return value == null ||
        value in ["AGAIN", "HARD", "GOOD", "EASY"];
    }

    function isValidRevisionSelectionAnchorForSource(data) {
      return (
        data.sourceKind == "MANUAL" &&
        data.selectionAnchor == null
      ) ||
      (
        data.sourceKind in ["SELECTION", "ANNOTATION"] &&
        isValidPrivateSelectionAnchor(data.selectionAnchor)
      ) ||
      (
        data.sourceKind == "FLASHCARD" &&
        (
          data.selectionAnchor == null ||
          isValidPrivateSelectionAnchor(data.selectionAnchor)
        )
      );
    }

    function isValidPrivateFlashcardData(uid, flashcardId, data) {
      return data is map &&
        data.keys().hasOnly([
          "answer",
          "blockId",
          "contentVersion",
          "createdAt",
          "flashcardId",
          "noteTitle",
          "prompt",
          "schemaVersion",
          "sectionId",
          "sectionTitle",
          "selectionAnchor",
          "shareState",
          "sourceId",
          "sourceKind",
          "state",
          "textbookId",
          "uid",
          "updatedAt"
        ]) &&
        data.keys().size() == 18 &&
        data.schemaVersion == 1 &&
        data.uid == uid &&
        data.flashcardId == flashcardId &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.flashcardId) &&
        isValidStudyId(data.sourceId) &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.sectionId) &&
        isValidStudyId(data.blockId) &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        isValidFlashcardSourceKind(data.sourceKind) &&
        (
          data.sourceKind != "ANNOTATION" ||
          data.sourceId.size() >= 1
        ) &&
        isValidFlashcardState(data.state) &&
        data.shareState == "PRIVATE" &&
        isValidRevisionText(data.prompt, 1000) &&
        isValidRevisionText(data.answer, 3000) &&
        isValidOptionalRevisionLabel(data.noteTitle) &&
        isValidOptionalRevisionLabel(data.sectionTitle) &&
        isValidRevisionSelectionAnchorForSource(data) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateRevisionData(uid, revisionId, data) {
      return data is map &&
        data.keys().hasOnly([
          "answer",
          "blockId",
          "contentVersion",
          "createdAt",
          "dueAt",
          "intervalDays",
          "lastRating",
          "lastReviewedAt",
          "noteTitle",
          "prompt",
          "recallStreak",
          "reviewCount",
          "revisionId",
          "schemaVersion",
          "sectionId",
          "sectionTitle",
          "selectionAnchor",
          "shareState",
          "sourceId",
          "sourceKind",
          "state",
          "textbookId",
          "uid",
          "updatedAt"
        ]) &&
        data.keys().size() == 24 &&
        data.schemaVersion == 1 &&
        data.uid == uid &&
        data.revisionId == revisionId &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.revisionId) &&
        isValidStudyId(data.sourceId) &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.sectionId) &&
        isValidStudyId(data.blockId) &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        isValidRevisionSourceKind(data.sourceKind) &&
        (
          data.sourceKind != "FLASHCARD" ||
          data.sourceId == revisionId
        ) &&
        isValidRevisionState(data.state) &&
        data.shareState == "PRIVATE" &&
        isValidRevisionText(data.prompt, 1000) &&
        isValidRevisionText(data.answer, 3000) &&
        isValidOptionalRevisionLabel(data.noteTitle) &&
        isValidOptionalRevisionLabel(data.sectionTitle) &&
        isValidRevisionSelectionAnchorForSource(data) &&
        data.dueAt is timestamp &&
        data.intervalDays is int &&
        data.intervalDays >= 0 &&
        data.intervalDays <= 180 &&
        data.reviewCount is int &&
        data.reviewCount >= 0 &&
        data.recallStreak is int &&
        data.recallStreak >= 0 &&
        isValidRecallRating(data.lastRating) &&
        (
          data.lastReviewedAt == null ||
          data.lastReviewedAt is timestamp
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function hasPairedFlashcardRevisionAfter(uid, flashcardId) {
      let path = /databases/$(database)/documents/studentLearning/$(uid)/revisionQueue/$(flashcardId);
      return existsAfter(path) &&
        getAfter(path).data.uid == uid &&
        getAfter(path).data.revisionId == flashcardId &&
        getAfter(path).data.sourceKind == "FLASHCARD" &&
        getAfter(path).data.sourceId == flashcardId;
    }

    function hasPairedFlashcardAfter(uid, revisionId) {
      let path = /databases/$(database)/documents/studentLearning/$(uid)/flashcards/$(revisionId);
      return existsAfter(path) &&
        getAfter(path).data.uid == uid &&
        getAfter(path).data.flashcardId == revisionId;
    }

    function isValidPrivateFlashcardCreate(uid, flashcardId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateFlashcardData(
          uid,
          flashcardId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        hasPairedFlashcardRevisionAfter(uid, flashcardId);
    }

    function isValidPrivateFlashcardUpdate(uid, flashcardId) {
      return isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateFlashcardData(
          uid,
          flashcardId,
          request.resource.data
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "prompt",
          "answer",
          "state",
          "updatedAt"
        ]) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateRevisionCreate(uid, revisionId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateRevisionData(
          uid,
          revisionId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (
          request.resource.data.sourceKind == "SELECTION" ||
          hasPairedFlashcardAfter(uid, revisionId)
        );
    }

    function isValidPrivateRevisionStateUpdate(uid, revisionId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "state",
          "updatedAt"
        ]) &&
        isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateRevisionData(
          uid,
          revisionId,
          request.resource.data
        ) &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateRevisionReviewUpdate(uid, revisionId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "dueAt",
          "intervalDays",
          "lastRating",
          "lastReviewedAt",
          "recallStreak",
          "reviewCount",
          "state",
          "updatedAt"
        ]) &&
        isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateRevisionData(
          uid,
          revisionId,
          request.resource.data
        ) &&
        request.resource.data.reviewCount == resource.data.reviewCount + 1 &&
        request.resource.data.lastRating in [
          "AGAIN",
          "HARD",
          "GOOD",
          "EASY"
        ] &&
        request.resource.data.lastReviewedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.dueAt > request.time &&
        request.resource.data.state == "ACTIVE";
    }

    function isValidMasteryOptionalLabel(value) {
      return value is string && value.size() <= 300;
    }

    function isValidMasteryConceptLabel(value) {
      return value is string && value.size() <= 180;
    }

    function isValidMistakeSourceKind(value) {
      return value in ["WRONG", "UNANSWERED"];
    }

    function isValidMistakeState(value) {
      return value in [
        "OPEN",
        "RETRY_DUE",
        "RETRIED",
        "RESOLVED",
        "ARCHIVED"
      ];
    }

    function isValidMasteryState(value) {
      return value in [
        "STARTING",
        "BUILDING",
        "RETRY_DUE",
        "STRONG",
        "EXAM_READY"
      ];
    }

    function isValidQuestionConceptMapping(data) {
      return (
        data.conceptId == "" &&
        data.conceptLabel == "" &&
        data.textbookId == "" &&
        data.sectionId == "" &&
        data.blockId == "" &&
        data.contentVersion == 0
      ) || (
        isValidStudyId(data.conceptId) &&
        isValidMasteryConceptLabel(data.conceptLabel) &&
        data.conceptLabel.size() >= 1 &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.sectionId) &&
        isValidStudyId(data.blockId) &&
        data.contentVersion is int &&
        data.contentVersion >= 1
      );
    }

    function isValidPrivateMistakeData(uid, mistakeId, data) {
      return data is map &&
        data.keys().hasOnly([
          "attemptId",
          "blockId",
          "chapter",
          "conceptId",
          "conceptLabel",
          "contentVersion",
          "createdAt",
          "firstSeenAt",
          "lastSeenAt",
          "mistakeId",
          "occurrenceCount",
          "questionId",
          "questionIndex",
          "resolvedAt",
          "resultId",
          "retriedAt",
          "retryDueAt",
          "schemaVersion",
          "sectionId",
          "shareState",
          "sourceKind",
          "state",
          "subject",
          "testId",
          "testTitle",
          "textbookId",
          "uid",
          "updatedAt"
        ]) &&
        data.keys().size() == 28 &&
        data.schemaVersion == 1 &&
        data.uid == uid &&
        data.mistakeId == mistakeId &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.mistakeId) &&
        isValidStudyId(data.resultId) &&
        isValidStudyId(data.attemptId) &&
        isValidStudyId(data.testId) &&
        isValidStudyId(data.questionId) &&
        data.questionIndex is int &&
        data.questionIndex >= 0 &&
        data.questionIndex <= 500 &&
        isValidQuestionConceptMapping(data) &&
        isValidMasteryOptionalLabel(data.testTitle) &&
        isValidMasteryOptionalLabel(data.subject) &&
        isValidMasteryOptionalLabel(data.chapter) &&
        data.occurrenceCount is int &&
        data.occurrenceCount >= 1 &&
        isValidMistakeSourceKind(data.sourceKind) &&
        isValidMistakeState(data.state) &&
        data.shareState == "PRIVATE" &&
        data.createdAt is timestamp &&
        data.firstSeenAt is timestamp &&
        data.lastSeenAt is timestamp &&
        data.retryDueAt is timestamp &&
        (
          data.retriedAt == null ||
          data.retriedAt is timestamp
        ) &&
        (
          data.resolvedAt == null ||
          data.resolvedAt is timestamp
        ) &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateMistakeCreate(uid, mistakeId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateMistakeData(
          uid,
          mistakeId,
          request.resource.data
        ) &&
        request.resource.data.state == "OPEN" &&
        request.resource.data.occurrenceCount >= 1 &&
        request.resource.data.createdAt == request.time &&
        (
          (
            request.resource.data.occurrenceCount == 1 &&
            request.resource.data.firstSeenAt == request.time
          ) || (
            request.resource.data.occurrenceCount > 1 &&
            request.resource.data.firstSeenAt <= request.time
          )
        ) &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.retryDueAt > request.time &&
        request.resource.data.retriedAt == null &&
        request.resource.data.resolvedAt == null;
    }

    function isValidMistakeStateTransition(before, after) {
      return before == after ||
        (
          before == "OPEN" &&
          after in ["RETRY_DUE", "RETRIED", "RESOLVED", "ARCHIVED"]
        ) ||
        (
          before == "RETRY_DUE" &&
          after in ["OPEN", "RETRIED", "RESOLVED", "ARCHIVED"]
        ) ||
        (
          before == "RETRIED" &&
          after in ["OPEN", "RETRY_DUE", "RESOLVED", "ARCHIVED"]
        ) ||
        (
          before == "RESOLVED" &&
          after in ["OPEN", "ARCHIVED"]
        ) ||
        (
          before == "ARCHIVED" &&
          after == "OPEN"
        );
    }

    function isValidPrivateMistakeUpdate(uid, mistakeId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "resolvedAt",
          "retriedAt",
          "retryDueAt",
          "state",
          "updatedAt"
        ]) &&
        isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateMistakeData(
          uid,
          mistakeId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.firstSeenAt == resource.data.firstSeenAt &&
        request.resource.data.lastSeenAt == resource.data.lastSeenAt &&
        request.resource.data.occurrenceCount == resource.data.occurrenceCount &&
        isValidMistakeStateTransition(
          resource.data.state,
          request.resource.data.state
        ) &&
        request.resource.data.updatedAt == request.time &&
        (
          request.resource.data.state != "RETRIED" ||
          request.resource.data.retriedAt == request.time
        ) &&
        (
          request.resource.data.state != "RESOLVED" ||
          request.resource.data.resolvedAt == request.time
        );
    }

    function isValidMasteryScore(value) {
      return value is int && value >= 0 && value <= 100;
    }

    function isValidMasteryStateForData(data) {
      return (
        data.overdueRetryCount > 0 &&
        data.masteryScore >= 50 &&
        data.state == "RETRY_DUE"
      ) || (
        data.overdueRetryCount == 0 &&
        data.masteryScore >= 85 &&
        data.practiceAccuracy >= 80 &&
        data.state == "EXAM_READY"
      ) || (
        data.overdueRetryCount == 0 &&
        data.masteryScore >= 70 &&
        (
          data.masteryScore < 85 ||
          data.practiceAccuracy < 80
        ) &&
        data.state == "STRONG"
      ) || (
        data.masteryScore >= 50 &&
        data.masteryScore <= 69 &&
        data.state == "RETRY_DUE"
      ) || (
        data.masteryScore >= 25 &&
        data.masteryScore <= 49 &&
        data.state == "BUILDING"
      ) || (
        data.masteryScore <= 24 &&
        data.state == "STARTING"
      );
    }

    function isValidPrivateMasteryData(uid, masteryId, data) {
      return data is map &&
        data.keys().hasOnly([
          "calculatedAt",
          "chapterId",
          "chapterLabel",
          "contentVersion",
          "correctCount",
          "createdAt",
          "mappedQuestionCount",
          "masteryId",
          "masteryScore",
          "mistakeCount",
          "overdueRetryCount",
          "practiceAccuracy",
          "practiceScore",
          "readingScore",
          "resolvedMistakeCount",
          "revisionCompleted",
          "revisionScore",
          "revisionTotal",
          "schemaVersion",
          "shareState",
          "state",
          "textbookId",
          "uid",
          "updatedAt"
        ]) &&
        data.keys().size() == 24 &&
        data.schemaVersion == 1 &&
        data.uid == uid &&
        data.masteryId == masteryId &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.masteryId) &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.chapterId) &&
        isValidMasteryOptionalLabel(data.chapterLabel) &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        isValidMasteryScore(data.readingScore) &&
        isValidMasteryScore(data.practiceScore) &&
        isValidMasteryScore(data.revisionScore) &&
        isValidMasteryScore(data.masteryScore) &&
        isValidMasteryScore(data.practiceAccuracy) &&
        data.mappedQuestionCount is int &&
        data.mappedQuestionCount >= 0 &&
        data.correctCount is int &&
        data.correctCount >= 0 &&
        data.correctCount <= data.mappedQuestionCount &&
        data.mistakeCount is int &&
        data.mistakeCount >= 0 &&
        data.resolvedMistakeCount is int &&
        data.resolvedMistakeCount >= 0 &&
        data.resolvedMistakeCount <= data.mistakeCount &&
        data.overdueRetryCount is int &&
        data.overdueRetryCount >= 0 &&
        data.overdueRetryCount <= data.mistakeCount &&
        data.revisionTotal is int &&
        data.revisionTotal >= 0 &&
        data.revisionCompleted is int &&
        data.revisionCompleted >= 0 &&
        data.revisionCompleted <= data.revisionTotal &&
        isValidMasteryState(data.state) &&
        isValidMasteryStateForData(data) &&
        data.shareState == "PRIVATE" &&
        data.calculatedAt is timestamp &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateMasteryCreate(uid, masteryId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateMasteryData(
          uid,
          masteryId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.calculatedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateMasteryUpdate(uid, masteryId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "calculatedAt",
          "correctCount",
          "mappedQuestionCount",
          "masteryScore",
          "mistakeCount",
          "overdueRetryCount",
          "practiceAccuracy",
          "practiceScore",
          "readingScore",
          "resolvedMistakeCount",
          "revisionCompleted",
          "revisionScore",
          "revisionTotal",
          "state",
          "updatedAt"
        ]) &&
        isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateMasteryData(
          uid,
          masteryId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.calculatedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /studentLearning/{uid} {
      allow read, write: if false;

      match /annotations/{annotationId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateAnnotationCreate(uid, annotationId);
        allow update: if isValidPrivateAnnotationUpdate(uid, annotationId);
        allow delete: if isStudentLearningOwner(uid) &&
          resource.data.uid == request.auth.uid;
      }

      match /bookmarks/{bookmarkId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateBookmarkCreate(uid, bookmarkId);
        allow update: if isValidPrivateBookmarkUpdate(uid, bookmarkId);
        allow delete: if isStudentLearningOwner(uid) &&
          resource.data.uid == request.auth.uid;
      }

      match /flashcards/{flashcardId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateFlashcardCreate(uid, flashcardId);
        allow update: if isValidPrivateFlashcardUpdate(uid, flashcardId);
        allow delete: if isStudentLearningOwner(uid) &&
          resource.data.uid == request.auth.uid &&
          !existsAfter(
            /databases/$(database)/documents/studentLearning/$(uid)/revisionQueue/$(flashcardId)
          );
      }

      match /revisionQueue/{revisionId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateRevisionCreate(uid, revisionId);
        allow update: if
          isValidPrivateRevisionStateUpdate(uid, revisionId) ||
          isValidPrivateRevisionReviewUpdate(uid, revisionId);
        allow delete: if isStudentLearningOwner(uid) &&
          resource.data.uid == request.auth.uid &&
          (
            resource.data.sourceKind != "FLASHCARD" ||
            !existsAfter(
              /databases/$(database)/documents/studentLearning/$(uid)/flashcards/$(revisionId)
            )
          );
      }


      match /mistakeBook/{mistakeId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateMistakeCreate(uid, mistakeId);
        allow update: if isValidPrivateMistakeUpdate(uid, mistakeId);
        allow delete: if false;
      }

      match /masteryProgress/{masteryId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateMasteryCreate(uid, masteryId);
        allow update: if isValidPrivateMasteryUpdate(uid, masteryId);
        allow delete: if false;
      }
    }


    /* ================================
       LP2 Identity / Role / Session Authority
       Server-owned role/status claims and revocation epoch.
       ================================ */

    match /roleAuthorities/{uid} {
      allow get: if isAuthenticated() &&
        (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /identityAuditLogs/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /accountDeviceSessions/{sessionId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.uid == request.auth.uid
        );
      allow create, update, delete: if false;
    }

    function isUidKeyedUserRequest(userId) {
      return request.resource.data.uid is string &&
        request.resource.data.uid == userId &&
        !userId.matches(".*@.*");
    }

    function isValidUsernameDocument(usernameId, data) {
      return usernameId is string &&
        usernameId.size() >= 3 &&
        usernameId.size() <= 24 &&
        usernameId.matches("^[a-z][a-z0-9_]*$") &&
        data.keys().hasOnly([
          "uid",
          "username",
          "normalizedUsername",
          "status",
          "createdAt",
          "updatedAt"
        ]) &&
        data.uid == request.auth.uid &&
        data.username == usernameId &&
        data.normalizedUsername == usernameId &&
        data.status == "active";
    }

    match /usernames/{usernameId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
        isValidUsernameDocument(usernameId, request.resource.data);
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.normalizedUsername == resource.data.normalizedUsername &&
        isValidUsernameDocument(usernameId, request.resource.data);
      allow delete: if isAdmin();
    }

    function isSafeUserUsernameUpdate(userId) {
      return isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.username is string &&
        request.resource.data.normalizedUsername == request.resource.data.username &&
        request.resource.data.username.size() >= 3 &&
        request.resource.data.username.size() <= 24 &&
        request.resource.data.username.matches("^[a-z][a-z0-9_]*$") &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "email",
          "username",
          "normalizedUsername",
          "updatedAt"
        ]);
    }

    function isSafeUserSelfCreate(userId) {
      return isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.get("email", "") == request.auth.token.email &&
        request.resource.data.get("normalizedEmail", request.auth.token.email) == request.auth.token.email &&
        request.resource.data.get("role", "student") == "student" &&
        request.resource.data.get("activeRole", "student") == "student" &&
        request.resource.data.get("accountStatus", "active") == "active" &&
        request.resource.data.get("isPremium", false) == false &&
        request.resource.data.get("premiumStatus", "FREE") in ["", "FREE"] &&
        request.resource.data.get("subscriptionType", "FREE") in ["", "FREE"] &&
        request.resource.data.get("planType", "FREE") in ["", "FREE"] &&
        !request.resource.data.keys().hasAny([
          "allowedRoles",
          "roles",
          "customClaims",
          "entitlements",
          "studentAccess"
        ]);
    }

    function isSafeUserSelfUpdate(userId) {
      return isOwner(userId) &&
        request.resource.data.get("uid", "") == resource.data.get("uid", "") &&
        request.resource.data.get("email", "") == resource.data.get("email", "") &&
        request.resource.data.get("normalizedEmail", "") == resource.data.get("normalizedEmail", "") &&
        request.resource.data.get("role", "student") == resource.data.get("role", "student") &&
        request.resource.data.get("activeRole", "student") == resource.data.get("activeRole", "student") &&
        request.resource.data.get("accountStatus", "active") == resource.data.get("accountStatus", "active") &&
        request.resource.data.get("isPremium", false) == resource.data.get("isPremium", false) &&
        request.resource.data.get("subscriptionType", "") == resource.data.get("subscriptionType", "") &&
        request.resource.data.get("premiumStatus", "") == resource.data.get("premiumStatus", "") &&
        request.resource.data.get("planType", "") == resource.data.get("planType", "") &&
        request.resource.data.get("accessStatus", "") == resource.data.get("accessStatus", "") &&
        request.resource.data.get("mentorUid", "") == resource.data.get("mentorUid", "") &&
        request.resource.data.get("mentorAssignmentStatus", "") == resource.data.get("mentorAssignmentStatus", "") &&
        request.resource.data.get("allowedRoles", []) == resource.data.get("allowedRoles", []);
    }

    match /users/{userId} {
      allow create: if isUidKeyedUserRequest(userId) &&
        (
          isAdmin() ||
          isSafeUserSelfCreate(userId)
        );

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isSafeUserSelfUpdate(userId);

      allow update: if isSafeUserUsernameUpdate(userId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ================================
       Learner Profile / Biodata System
       ================================ */

    function isLearnerProfileOwnerExisting(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.normalizedEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        );
    }

    function isLearnerProfileOwnerRequest(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.normalizedEmail == request.auth.token.email ||
          request.resource.data.email == request.auth.token.email
        );
    }

    function studentProfileIdentitySafe() {
      return request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.role == "student" &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function studentDefaultMentorFieldsSafe() {
      return request.resource.data.mentorEmail == "dr.varshamaru@gmail.com" &&
        request.resource.data.mentorName == "Dr. Varsha Maru" &&
        request.resource.data.mentorAssignmentStatus == "active" &&
        request.resource.data.mentorAssignmentSource == "default-mentor-v1";
    }

    function studentProfileCreateKeysOnly() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
