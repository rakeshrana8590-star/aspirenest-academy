rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "aspirenestplatform@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /* ================================
       IntelliText Admin Authoring + Published Graph — Phase 8B-5
       DIRECT_STUDENT_DRAFT_READ=DENIED
       Published reads require explicit publicRead or one active entitlement.
       ================================ */

    function isValidLearningTextAccessMap(access) {
      return access is map &&
        access.keys().hasOnly([
          "publicRead",
          "readEntitlementIds",
          "requiredPlanCode"
        ]) &&
        access.publicRead is bool &&
        access.readEntitlementIds is list &&
        access.readEntitlementIds.size() <= 6 &&
        (
          access.requiredPlanCode == null ||
          access.requiredPlanCode is string
        );
    }

    function isActiveLearningTextEntitlementData(data) {
      let accessFrom = data.get("accessFrom", null);
      let accessUntil = data.get("accessUntil", null);
      let noExpiry = data.get("noExpiry", false) == true;
      let untilManualChange = data.get("untilManualChange", false) == true;
      return data.status == "active" &&
        (
          accessFrom == null ||
          (accessFrom is timestamp && accessFrom <= request.time)
        ) &&
        (
          noExpiry ||
          untilManualChange ||
          (accessUntil is timestamp && accessUntil > request.time)
        );
    }

    function hasActiveLearningTextEntitlement(entitlementId) {
      let entitlementPath = /databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(entitlementId);
      return entitlementId is string &&
        entitlementId.size() >= 1 &&
        entitlementId.size() <= 128 &&
        exists(entitlementPath) &&
        isActiveLearningTextEntitlementData(
          get(entitlementPath).data
        );
    }

    function hasValidLearningTextEntitlement(data) {
      let ids = data.access.readEntitlementIds;
      return isSignedIn() &&
        ids.size() >= 1 &&
        ids.size() <= 6 &&
        (
          (ids.size() > 0 && hasActiveLearningTextEntitlement(ids[0])) ||
          (ids.size() > 1 && hasActiveLearningTextEntitlement(ids[1])) ||
          (ids.size() > 2 && hasActiveLearningTextEntitlement(ids[2])) ||
          (ids.size() > 3 && hasActiveLearningTextEntitlement(ids[3])) ||
          (ids.size() > 4 && hasActiveLearningTextEntitlement(ids[4])) ||
          (ids.size() > 5 && hasActiveLearningTextEntitlement(ids[5]))
        );
    }

    function isPublishedLearningTextReadable(data, textbookId) {
      return data.textbookId == textbookId &&
        data.resourceType == "NOTE" &&
        data.deliveryMode == "NATIVE_TEXT" &&
        data.publicationState == "PUBLISHED" &&
        data.nativeReady == true &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        isValidLearningTextAccessMap(data.access) &&
        (
          data.access.publicRead == true ||
          hasValidLearningTextEntitlement(data)
        );
    }

    match /learningTexts/{textbookId} {
      allow get: if isAdmin() ||
        isPublishedLearningTextReadable(resource.data, textbookId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /authoringVersions/{versionId} {
        allow read, write: if isAdmin();

        match /sections/{sectionId} {
          allow read, write: if isAdmin();

          match /blocks/{blockId} {
            allow read, write: if isAdmin();
          }
        }
      }

      match /sections/{sectionId} {
        allow get, list: if isAdmin() ||
          isPublishedLearningTextReadable(
            get(
              /databases/$(database)/documents/learningTexts/$(textbookId)
            ).data,
            textbookId
          );
        allow create, update, delete: if isAdmin();

        match /blocks/{blockId} {
          allow get, list: if isAdmin() ||
            isPublishedLearningTextReadable(
              get(
                /databases/$(database)/documents/learningTexts/$(textbookId)
              ).data,
              textbookId
            );
          allow create, update, delete: if isAdmin();
        }
      }
    }

    function isProgressOwner() {
      return isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    function isExistingProgressOwner() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /students/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    /* ================================
       IntelliText Private Study Workspace — Phase 8B-4
       Authenticated UID owner-only; no admin or mentor bypass.
       ================================ */

    function isStudentLearningOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidStudyId(value) {
      return value is string &&
        value.size() >= 1 &&
        value.size() <= 128 &&
        value.matches("^[A-Za-z0-9_-]+$");
    }

    function isValidPrivateSelectionAnchor(anchor) {
      return anchor is map &&
        anchor.keys().hasOnly([
          "exactText",
          "prefix",
          "suffix",
          "startOffset",
          "endOffset"
        ]) &&
        anchor.keys().size() == 5 &&
        anchor.exactText is string &&
        anchor.exactText.size() >= 1 &&
        anchor.exactText.size() <= 2000 &&
        anchor.prefix is string &&
        anchor.prefix.size() <= 128 &&
        anchor.suffix is string &&
        anchor.suffix.size() <= 128 &&
        anchor.startOffset is int &&
        anchor.startOffset >= 0 &&
        anchor.endOffset is int &&
        anchor.endOffset > anchor.startOffset;
    }

    function isValidPrivateAnnotationData(uid, annotationId, data) {
      return data.keys().hasOnly([
          "schemaVersion",
          "annotationId",
          "uid",
          "textbookId",
          "sectionId",
          "blockId",
          "contentVersion",
          "type",
          "state",
          "shareState",
          "selectionAnchor",
          "body",
          "createdAt",
          "updatedAt"
        ]) &&
        data.keys().size() == 14 &&
        data.schemaVersion == 1 &&
        data.annotationId == annotationId &&
        data.uid == uid &&
        isValidStudyId(data.annotationId) &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.sectionId) &&
        isValidStudyId(data.blockId) &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        data.type in ["HIGHLIGHT", "UNDERLINE", "NOTE", "DOUBT"] &&
        data.state in ["ACTIVE", "RESOLVED"] &&
        data.shareState == "PRIVATE" &&
        isValidPrivateSelectionAnchor(data.selectionAnchor) &&
        data.body is string &&
        data.body.size() <= 4000 &&
        (
          !(data.type in ["NOTE", "DOUBT"]) ||
          data.body.size() >= 1
        ) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateAnnotationCreate(uid, annotationId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateAnnotationData(
          uid,
          annotationId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateAnnotationUpdate(uid, annotationId) {
      return isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateAnnotationData(
          uid,
          annotationId,
          request.resource.data
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "body",
          "state",
          "updatedAt"
        ]) &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateBookmarkData(uid, bookmarkId, data) {
      return data.keys().hasOnly([
          "schemaVersion",
          "bookmarkId",
          "uid",
          "textbookId",
          "sectionId",
          "blockId",
          "contentVersion",
          "shareState",
          "label",
          "createdAt",
          "updatedAt"
        ]) &&
        data.keys().size() == 11 &&
        data.schemaVersion == 1 &&
        data.bookmarkId == bookmarkId &&
        data.uid == uid &&
        isValidStudyId(data.bookmarkId) &&
        isValidStudyId(data.uid) &&
        isValidStudyId(data.textbookId) &&
        isValidStudyId(data.sectionId) &&
        isValidStudyId(data.blockId) &&
        data.contentVersion is int &&
        data.contentVersion >= 1 &&
        data.shareState == "PRIVATE" &&
        data.label is string &&
        data.label.size() <= 300 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateBookmarkCreate(uid, bookmarkId) {
      return isStudentLearningOwner(uid) &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateBookmarkData(
          uid,
          bookmarkId,
          request.resource.data
        ) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidPrivateBookmarkUpdate(uid, bookmarkId) {
      return isStudentLearningOwner(uid) &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        isValidPrivateBookmarkData(
          uid,
          bookmarkId,
          request.resource.data
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "label",
          "updatedAt"
        ]) &&
        request.resource.data.updatedAt == request.time;
    }

    match /studentLearning/{uid} {
      allow read, write: if false;

      match /annotations/{annotationId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateAnnotationCreate(uid, annotationId);
        allow update: if isValidPrivateAnnotationUpdate(uid, annotationId);
        allow delete: if isStudentLearningOwner(uid) &&
          resource.data.uid == request.auth.uid;
      }

      match /bookmarks/{bookmarkId} {
        allow get, list: if isStudentLearningOwner(uid);
        allow create: if isValidPrivateBookmarkCreate(uid, bookmarkId);
        allow update: if isValidPrivateBookmarkUpdate(uid, bookmarkId);
        allow delete: if isStudentLearningOwner(uid) &&
          resource.data.uid == request.auth.uid;
      }
    }


    function isUidKeyedUserRequest(userId) {
      return request.resource.data.uid is string &&
        request.resource.data.uid == userId &&
        !userId.matches(".*@.*");
    }

    match /users/{userId} {
      allow create: if
        (isOwner(userId) || isAdmin()) &&
        isUidKeyedUserRequest(userId);

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isOwner(userId)
        && request.resource.data.isPremium == resource.data.isPremium
        && request.resource.data.subscriptionType == resource.data.subscriptionType
        && request.resource.data.premiumStatus == resource.data.premiumStatus;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /* ================================
       Learner Profile / Biodata System
       ================================ */

    function isLearnerProfileOwnerExisting(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.normalizedEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        );
    }

    function isLearnerProfileOwnerRequest(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.normalizedEmail == request.auth.token.email ||
          request.resource.data.email == request.auth.token.email
        );
    }

    function studentProfileIdentitySafe() {
      return request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.role == "student" &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function studentProfileCreateKeysOnly() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
        "authProvider",
        "emailVerified",
        "lastLoginAt",
        "profileCompletion",
        "profileMissingFields",
        "profileStatus",
        "source",
        "updatedAt",
        "updatedBy",
        "createdAt",
        "createdBy"
      ]);
    }

    function studentProfileUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
        "authProvider",
        "emailVerified",
        "lastLoginAt",
        "profileCompletion",
        "profileMissingFields",
        "profileStatus",
        "source",
        "updatedAt",
        "updatedBy",
        "createdAt",
        "createdBy"
      ]);
    }

    match /learnerProfiles/{profileId} {
      allow create: if isAdmin() ||
        (
          isLearnerProfileOwnerRequest(profileId) &&
          studentProfileIdentitySafe() &&
          studentProfileCreateKeysOnly()
        );

      allow read: if isAdmin() || isLearnerProfileOwnerExisting(profileId);

      allow update: if isAdmin() ||
        (
          isLearnerProfileOwnerExisting(profileId) &&
          isLearnerProfileOwnerRequest(profileId) &&
          studentProfileIdentitySafe() &&
          studentProfileUpdateKeysOnly()
        );

      allow delete: if isAdmin();
    }

    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /protectedContentAssets/{assetId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /contentItems/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /universalContent/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    match /experienceEvents/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /mockResults/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.email == request.auth.token.email;

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.token.email == resource.data.email);

      allow update: if isAdmin() ||
        (
          isSignedIn()
          && resource.data.email == request.auth.token.email
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "testTitle",
            "score",
            "totalMarks",
            "percentage",
            "accuracy",
            "correctCount",
            "wrongCount",
            "skippedCount",
            "totalQuestions",
            "durationSeconds",
            "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    function isMockLeaderboardOwner() {
      return isSignedIn() &&
        (
          resource.data.get("ownerUid", "") == request.auth.uid ||
          resource.data.get("studentEmail", "") ==
            request.auth.token.email ||
          resource.data.get("email", "") ==
            request.auth.token.email
        );
    }

    match /mockLeaderboard/{docId} {
      allow read: if isAdmin() || isMockLeaderboardOwner();

      /*
       * Private operational ranking records are written only by
       * the authenticated Cloud Function through the Admin SDK.
       * No browser client, including admin UI, may write them.
       */
      allow create, update, delete: if false;
    }

    match /mockLeaderboardPublic/{docId} {
      /*
       * Public-safe projections contain no email, UID, attempt id,
       * answer payload, private result id, or raw ownership fields.
       */
      allow read: if true;

      /*
       * The public projection is server-generated from the private
       * operational record. Browser writes always fail closed.
       */
      allow create, update, delete: if false;
    }

    match /questionBank/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /mockQuestions/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notesSubjects/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notesChapters/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /currentAffairs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    function isActivePlanProductData(product) {
      return product.productId is string &&
        product.productId != "" &&
        product.scopeType == "plan" &&
        product.status == "active" &&
        product.isActive == true &&
        product.planCode is string &&
        product.planCode != "" &&
        product.planType == product.planCode &&
        product.accessRank is int &&
        product.accessRank >= 0 &&
        product.priceINR is int &&
        product.priceINR >= 0 &&
        product.currency is string &&
        product.currency != "" &&
        product.priceVersion is int &&
        product.priceVersion >= 1 &&
        product.fixed365DayValidity == false;
    }

    function isActivePlanProduct(productId) {
      return productId is string &&
        productId != "" &&
        exists(/databases/$(database)/documents/accessProducts/$(productId)) &&
        get(/databases/$(database)/documents/accessProducts/$(productId)).data.productId == productId &&
        isActivePlanProductData(
          get(/databases/$(database)/documents/accessProducts/$(productId)).data
        );
    }

    match /payments/{docId} {
      function isPaymentOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      function isNewPaymentOwner() {
        return isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.studentEmail == request.auth.token.email;
      }

      function isDynamicPaymentSnapshotMatch(productId) {
        let product = get(
          /databases/$(database)/documents/accessProducts/$(productId)
        ).data;
        let snapshot = request.resource.data.productSnapshot;

        return snapshot is map &&
          snapshot.keys().hasOnly([
            "productId",
            "planCode",
            "planType",
            "title",
            "description",
            "accessRank",
            "scopeType",
            "priceINR",
            "compareAtPriceINR",
            "currency",
            "priceVersion",
            "priceEffectiveFrom",
            "validityMode",
            "defaultValidityDays",
            "allowNoExpiry",
            "fixed365DayValidity",
            "capturedAt"
          ]) &&
          snapshot.keys().hasAll([
            "productId",
            "planCode",
            "planType",
            "title",
            "description",
            "accessRank",
            "scopeType",
            "priceINR",
            "compareAtPriceINR",
            "currency",
            "priceVersion",
            "priceEffectiveFrom",
            "validityMode",
            "defaultValidityDays",
            "allowNoExpiry",
            "fixed365DayValidity",
            "capturedAt"
          ]) &&
          snapshot.productId == productId &&
          snapshot.planCode == product.planCode &&
          snapshot.planType == product.planCode &&
          snapshot.title == product.title &&
          snapshot.description == product.description &&
          snapshot.accessRank == product.accessRank &&
          snapshot.scopeType == "plan" &&
          snapshot.priceINR == product.priceINR &&
          snapshot.compareAtPriceINR == product.compareAtPriceINR &&
          snapshot.currency == product.currency &&
          snapshot.priceVersion == product.priceVersion &&
          snapshot.priceEffectiveFrom == product.priceEffectiveFrom &&
          snapshot.validityMode == product.validityMode &&
          snapshot.defaultValidityDays == product.defaultValidityDays &&
          snapshot.allowNoExpiry == product.allowNoExpiry &&
          snapshot.fixed365DayValidity == false &&
          snapshot.capturedAt == request.resource.data.createdAt;
      }

      function isStudentPaymentCreate() {
        let productId = request.resource.data.productId;
        let product = get(
          /databases/$(database)/documents/accessProducts/$(productId)
        ).data;

        return isNewPaymentOwner() &&
          request.resource.data.keys().hasOnly([
            "orderId",
            "userId",
            "upiLink",
            "studentEmail",
            "studentMobile",
            "studentName",
            "planName",
            "planType",
            "planCode",
            "productId",
            "accessRank",
            "amount",
            "currency",
            "priceVersion",
            "priceEffectiveFrom",
            "productSnapshot",
            "fixed365DayValidity",
            "status",
            "studentProof",
            "adminProof",
            "matchStatus",
            "createdAt"
          ]) &&
          request.resource.data.keys().hasAll([
            "orderId",
            "userId",
            "upiLink",
            "studentEmail",
            "studentMobile",
            "studentName",
            "planName",
            "planType",
            "planCode",
            "productId",
            "accessRank",
            "amount",
            "currency",
            "priceVersion",
            "priceEffectiveFrom",
            "productSnapshot",
            "fixed365DayValidity",
            "status",
            "studentProof",
            "adminProof",
            "matchStatus",
            "createdAt"
          ]) &&
          request.resource.data.orderId is string &&
          request.resource.data.orderId != "" &&
          request.resource.data.upiLink is string &&
          request.resource.data.studentMobile is string &&
          request.resource.data.studentName is string &&
          request.resource.data.createdAt is timestamp &&
          isActivePlanProduct(productId) &&
          product.priceINR > 0 &&
          request.resource.data.planName == product.title &&
          request.resource.data.planType == product.planCode &&
          request.resource.data.planCode == product.planCode &&
          request.resource.data.accessRank == product.accessRank &&
          request.resource.data.amount == product.priceINR &&
          request.resource.data.currency == product.currency &&
          request.resource.data.priceVersion == product.priceVersion &&
          request.resource.data.priceEffectiveFrom == product.priceEffectiveFrom &&
          request.resource.data.fixed365DayValidity == false &&
          isDynamicPaymentSnapshotMatch(productId) &&
          request.resource.data.status == "pending_payment" &&
          request.resource.data.studentProof == "" &&
          request.resource.data.adminProof == "" &&
          request.resource.data.matchStatus == "waiting";
      }

      function isStudentProofSubmit() {
        return isPaymentOwner() &&
          resource.data.status in ["pending_payment", "student_proof_submitted"] &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.studentEmail == resource.data.studentEmail &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "studentProof",
            "status",
            "updatedAt"
          ]) &&
          request.resource.data.status == "student_proof_submitted" &&
          request.resource.data.studentProof is string &&
          request.resource.data.studentProof.size() > 0;
      }

      allow create: if isAdmin() || isStudentPaymentCreate();

      allow read: if isAdmin() || isPaymentOwner();

      allow update: if isAdmin() || isStudentProofSubmit();

      allow delete: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pricingPlans/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studentActivity/{docId} {
      allow create: if isSignedIn();

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.userId);

      allow update, delete: if isAdmin();
    }

    /* ================================
       AspirePath / Roadmap Studio
       ================================ */

    match /studyRoadmaps/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapDays/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapResourceLinks/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapProgress/{docId} {
      allow create: if isProgressOwner();

      allow read: if isAdmin() || isExistingProgressOwner();

      allow update: if isAdmin() ||
        (
          isExistingProgressOwner() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.roadmapId == resource.data.roadmapId &&
          request.resource.data.dayId == resource.data.dayId
        );

      allow delete: if isAdmin();
    }

    match /studyRoadmapAnalytics/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    /* ================================
       Access Engine
       ================================ */

    function isRedeemEmailMatch(emailValue) {
      return emailValue == request.auth.token.email;
    }

    function isAccessKeyAssignedToRequester() {
      return resource.data.assignedEmail == null ||
        resource.data.assignedEmail == "" ||
        resource.data.assignedEmail == request.auth.token.email;
    }

    function legacyPlanAccessRank(planCode) {
      return planCode == "FREE"
        ? 0
        : planCode == "BASIC"
          ? 100
          : planCode == "PREMIUM"
            ? 200
            : planCode == "MENTORSHIP"
              ? 300
              : null;
    }

    function isRedeemValidityShape() {
      return request.resource.data.validityMode in [
          "CUSTOM_WINDOW",
          "NO_EXPIRY",
          "UNTIL_MANUAL_CHANGE"
        ] &&
        request.resource.data.noExpiry is bool &&
        request.resource.data.untilManualChange is bool &&
        !(request.resource.data.noExpiry && request.resource.data.untilManualChange) &&
        (
          (
            request.resource.data.validityMode == "CUSTOM_WINDOW" &&
            request.resource.data.noExpiry == false &&
            request.resource.data.untilManualChange == false &&
            request.resource.data.accessUntil != null &&
            request.resource.data.accessUntil != ""
          ) ||
          (
            request.resource.data.validityMode == "NO_EXPIRY" &&
            request.resource.data.noExpiry == true &&
            request.resource.data.untilManualChange == false &&
            request.resource.data.accessUntil == null
          ) ||
          (
            request.resource.data.validityMode == "UNTIL_MANUAL_CHANGE" &&
            request.resource.data.noExpiry == false &&
            request.resource.data.untilManualChange == true &&
            request.resource.data.accessUntil == null
          )
        );
    }

    function isDirectKeyValidityMatch(key) {
      let explicitUntil = key.get("accessUntil", null);
      let noExpiry = key.get("noExpiry", false) == true ||
        key.get("validityMode", "") == "NO_EXPIRY";
      let untilManualChange = key.get("untilManualChange", false) == true ||
        key.get("validityMode", "") == "UNTIL_MANUAL_CHANGE";

      return isRedeemValidityShape() &&
        (
          key.get("accessFrom", null) == null ||
          key.get("accessFrom", null) == "" ||
          request.resource.data.accessFrom == key.get("accessFrom", null)
        ) &&
        (
          (
            explicitUntil != null &&
            explicitUntil != "" &&
            request.resource.data.accessUntil == explicitUntil &&
            request.resource.data.validityMode == "CUSTOM_WINDOW"
          ) ||
          (
            noExpiry &&
            request.resource.data.noExpiry == true
          ) ||
          (
            untilManualChange &&
            request.resource.data.untilManualChange == true
          )
        );
    }

    function isProductKeyValidityMatch(key, product) {
      let keyUntil = key.get("accessUntil", null);
      let productUntil = product.get("accessUntil", null);
      let explicitUntil = keyUntil != null && keyUntil != ""
        ? keyUntil
        : productUntil;
      let noExpiry = key.get("noExpiry", false) == true ||
        key.get("validityMode", "") == "NO_EXPIRY" ||
        product.get("validityMode", "") == "NO_EXPIRY";
      let untilManualChange = key.get("untilManualChange", false) == true ||
        key.get("validityMode", "") == "UNTIL_MANUAL_CHANGE" ||
        product.get("validityMode", "") == "UNTIL_MANUAL_CHANGE";
      let keyFrom = key.get("accessFrom", null);
      let productFrom = product.get("accessFrom", null);
      let expectedFrom = keyFrom != null && keyFrom != ""
        ? keyFrom
        : productFrom;

      return isRedeemValidityShape() &&
        (
          expectedFrom == null ||
          expectedFrom == "" ||
          request.resource.data.accessFrom == expectedFrom
        ) &&
        (
          (
            explicitUntil != null &&
            explicitUntil != "" &&
            request.resource.data.accessUntil == explicitUntil &&
            request.resource.data.validityMode == "CUSTOM_WINDOW"
          ) ||
          (
            noExpiry &&
            (
              product.scopeType != "plan" ||
              product.get("allowNoExpiry", false) == true
            ) &&
            request.resource.data.noExpiry == true
          ) ||
          (
            untilManualChange &&
            request.resource.data.untilManualChange == true
          )
        );
    }

    function isProductPlanSnapshotMatch(product) {
      let snapshot = request.resource.data.purchaseTermsSnapshot;

      return snapshot is map &&
        snapshot.keys().hasOnly([
          "productId",
          "planCode",
          "planType",
          "accessRank",
          "priceINR",
          "compareAtPriceINR",
          "currency",
          "priceVersion",
          "priceEffectiveFrom",
          "validityMode",
          "accessFrom",
          "accessUntil",
          "noExpiry",
          "untilManualChange",
          "capturedAt"
        ]) &&
        snapshot.keys().size() == 15 &&
        snapshot.productId == product.productId &&
        snapshot.planCode == product.planCode &&
        snapshot.planType == product.planCode &&
        snapshot.accessRank == product.accessRank &&
        snapshot.priceINR == product.priceINR &&
        snapshot.compareAtPriceINR == product.compareAtPriceINR &&
        snapshot.currency == product.currency &&
        snapshot.priceVersion == product.priceVersion &&
        snapshot.priceEffectiveFrom == product.priceEffectiveFrom &&
        snapshot.validityMode == request.resource.data.validityMode &&
        snapshot.noExpiry == request.resource.data.noExpiry &&
        snapshot.untilManualChange == request.resource.data.untilManualChange &&
        snapshot.capturedAt is timestamp &&
        (
          snapshot.accessFrom == null ||
          snapshot.accessFrom is timestamp
        ) &&
        (
          snapshot.accessUntil == null ||
          snapshot.accessUntil is timestamp
        ) &&
        request.resource.data.termsSnapshot == snapshot &&
        request.resource.data.priceVersion == product.priceVersion;
    }

    function isAccessKeyRedeemUpdate(keyCode) {
      let data = request.resource.data;
      let access = getAfter(
        /databases/$(database)/documents/studentAccess/$(data.lastRedemptionAccessId)
      ).data;
      let entitlement = getAfter(
        /databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(data.lastRedemptionEntitlementId)
      ).data;
      let audit = getAfter(
        /databases/$(database)/documents/accessAuditLogs/$(data.lastRedemptionAuditId)
      ).data;
      return isSignedIn() &&
        keyCode == resource.data.normalizedCode &&
        resource.data.status == "active" &&
        resource.data.usedCount < resource.data.maxUses &&
        isAccessKeyAssignedToRequester() &&
        data.diff(resource.data).affectedKeys().hasOnly([
          "usedCount",
          "status",
          "lastRedeemedByEmail",
          "lastRedeemedByUid",
          "lastRedeemedAt",
          "redeemedByEmail",
          "redeemedByUid",
          "redeemedAt",
          "lastRedemptionAccessId",
          "lastRedemptionEntitlementId",
          "lastRedemptionAuditId",
          "updatedAt",
          "updatedBy"
        ]) &&
        data.usedCount == resource.data.usedCount + 1 &&
        (
          (
            data.usedCount < data.maxUses &&
            data.status == "active"
          ) ||
          (
            data.usedCount >= data.maxUses &&
            data.status == "used"
          )
        ) &&
        data.lastRedeemedByEmail == request.auth.token.email &&
        data.lastRedeemedByUid == request.auth.uid &&
        (
          data.redeemedByEmail == resource.data.redeemedByEmail ||
          data.redeemedByEmail == request.auth.token.email
        ) &&
        (
          data.redeemedByUid == resource.data.redeemedByUid ||
          data.redeemedByUid == request.auth.uid
        ) &&
        data.lastRedemptionAccessId is string &&
        data.lastRedemptionEntitlementId is string &&
        data.lastRedemptionAuditId is string &&
        existsAfter(
          /databases/$(database)/documents/studentAccess/$(data.lastRedemptionAccessId)
        ) &&
        access.uid == request.auth.uid &&
        existsAfter(
          /databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(data.lastRedemptionEntitlementId)
        ) &&
        entitlement.accessId == data.lastRedemptionAccessId &&
        existsAfter(
          /databases/$(database)/documents/accessAuditLogs/$(data.lastRedemptionAuditId)
        ) &&
        audit.accessId == data.lastRedemptionAccessId &&
        data.updatedBy == request.auth.uid;
    }

    function isRedeemDirectKeyAccessMatches(accessKeyId) {
      let key = get(
        /databases/$(database)/documents/accessKeys/$(accessKeyId)
      ).data;
      let planCode = key.get("planCode", key.planType);
      let accessRank = key.get(
        "accessRank",
        legacyPlanAccessRank(planCode)
      );
      let purchaseTermsSnapshot = key.get(
        "purchaseTermsSnapshot",
        key.get("termsSnapshot", null)
      );

      return (key.productId == null || key.productId == "") &&
        request.resource.data.productId == key.productId &&
        request.resource.data.course == key.course &&
        request.resource.data.planType == planCode &&
        request.resource.data.planCode == planCode &&
        request.resource.data.accessRank == accessRank &&
        request.resource.data.scopeType == key.scopeType &&
        request.resource.data.module == key.module &&
        request.resource.data.itemType == key.itemType &&
        request.resource.data.itemId == key.itemId &&
        request.resource.data.itemIds == key.itemIds &&
        request.resource.data.bundleId == key.bundleId &&
        request.resource.data.purchaseTermsSnapshot == purchaseTermsSnapshot &&
        request.resource.data.termsSnapshot == purchaseTermsSnapshot &&
        request.resource.data.priceVersion == key.get("priceVersion", null) &&
        isDirectKeyValidityMatch(key);
    }

    function isRedeemProductAccessMatches(accessKeyId) {
      let key = get(
        /databases/$(database)/documents/accessKeys/$(accessKeyId)
      ).data;
      let product = get(
        /databases/$(database)/documents/accessProducts/$(key.productId)
      ).data;
      let planCode = product.get("planCode", product.planType);
      let accessRank = product.get(
        "accessRank",
        key.get(
          "accessRank",
          legacyPlanAccessRank(planCode)
        )
      );
      let isPlanProduct = product.scopeType == "plan";

      return key.productId is string &&
        key.productId != "" &&
        exists(/databases/$(database)/documents/accessProducts/$(key.productId)) &&
        (
          !isPlanProduct ||
          product.productId == key.productId
        ) &&
        product.status == "active" &&
        (
          (isPlanProduct && product.isActive == true) ||
          (!isPlanProduct && product.get("isActive", true) != false)
        ) &&
        request.resource.data.productId == key.productId &&
        request.resource.data.course == product.course &&
        request.resource.data.planType == planCode &&
        request.resource.data.planCode == planCode &&
        request.resource.data.accessRank == accessRank &&
        request.resource.data.scopeType == product.scopeType &&
        request.resource.data.module == product.get("module", null) &&
        request.resource.data.itemType == product.get("itemType", null) &&
        request.resource.data.itemId == product.get("itemId", null) &&
        request.resource.data.itemIds == product.get("itemIds", []) &&
        request.resource.data.bundleId == product.get("bundleId", null) &&
        isProductKeyValidityMatch(key, product) &&
        (
          (
            product.scopeType == "plan" &&
            isProductPlanSnapshotMatch(product)
          ) ||
          (
            product.scopeType != "plan" &&
            request.resource.data.purchaseTermsSnapshot == null &&
            request.resource.data.termsSnapshot == null &&
            request.resource.data.priceVersion == null
          )
        );
    }

    function isRedeemStudentAccessCreate(accessDocId) {
      let data = request.resource.data;
      let key = get(
        /databases/$(database)/documents/accessKeys/$(data.accessKeyId)
      ).data;
      let redeemedKey = getAfter(
        /databases/$(database)/documents/accessKeys/$(data.accessKeyId)
      ).data;
      return isSignedIn() &&
        data.keys().hasOnly([
          "email",
          "normalizedEmail",
          "uid",
          "planType",
          "planCode",
          "accessRank",
          "productId",
          "purchaseTermsSnapshot",
          "termsSnapshot",
          "priceVersion",
          "validityMode",
          "noExpiry",
          "untilManualChange",
          "scopeType",
          "status",
          "source",
          "course",
          "module",
          "itemType",
          "itemId",
          "itemTitle",
          "itemIds",
          "bundleId",
          "accessKeyId",
          "campaignId",
          "campaignName",
          "campaignSource",
          "learnerName",
          "name",
          "phone",
          "accessFrom",
          "accessUntil",
          "notes",
          "adminNote",
          "updatedAt",
          "createdAt",
          "createdBy",
          "actorEmail"
        ]) &&
        data.keys().size() == 38 &&
        data.source == "redeem_key" &&
        data.status == "active" &&
        data.uid == request.auth.uid &&
        data.email == request.auth.token.email &&
        data.normalizedEmail == request.auth.token.email &&
        data.planCode == data.planType &&
        data.accessRank is int &&
        data.accessRank >= 0 &&
        data.termsSnapshot == data.purchaseTermsSnapshot &&
        (
          data.priceVersion == null ||
          (
            data.priceVersion is int &&
            data.priceVersion >= 1
          )
        ) &&
        data.updatedAt is timestamp &&
        data.createdAt is timestamp &&
        data.createdBy == request.auth.uid &&
        data.actorEmail == request.auth.token.email &&
        data.accessKeyId is string &&
        data.accessKeyId != "" &&
        exists(/databases/$(database)/documents/accessKeys/$(data.accessKeyId)) &&
        key.status == "active" &&
        key.usedCount <
          key.maxUses &&
        (
          key.assignedEmail == null ||
          key.assignedEmail == "" ||
          key.assignedEmail == request.auth.token.email
        ) &&
        (
          isRedeemDirectKeyAccessMatches(data.accessKeyId) ||
          isRedeemProductAccessMatches(data.accessKeyId)
        ) &&
        redeemedKey.lastRedemptionAccessId == accessDocId &&
        redeemedKey.lastRedemptionEntitlementId is string &&
        redeemedKey.lastRedemptionAuditId is string;
    }

    function isInviteOwnRecord() {
      return isSignedIn() && (
        resource.data.normalizedEmail == request.auth.token.email ||
        resource.data.email == request.auth.token.email
      );
    }

    function isInviteOpenUpdate(inviteCode) {
      return isInviteOwnRecord() &&
        inviteCode == resource.data.inviteCode &&
        request.time < resource.data.expiresAt &&
        resource.data.inviteStatus in ["pending", "copied", "sent"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "inviteStatus",
          "openedAt",
          "openedByUid",
          "openedByEmail",
          "openAuditId",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.inviteStatus == "opened" &&
        request.resource.data.openedByUid == request.auth.uid &&
        request.resource.data.openedByEmail == request.auth.token.email &&
        request.resource.data.openAuditId is string &&
        existsAfter(
          /databases/$(database)/documents/accessAuditLogs/$(request.resource.data.openAuditId)
        ) &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteRedeemUpdate(inviteCode) {
      return isInviteOwnRecord() &&
        inviteCode == resource.data.inviteCode &&
        request.time < resource.data.expiresAt &&
        resource.data.inviteStatus in ["pending", "copied", "sent", "opened"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "inviteStatus",
          "usedAt",
          "redeemedByUid",
          "redeemedByEmail",
          "redeemSource",
          "redeemEntitlementId",
          "redeemAuditId",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.inviteStatus == "used" &&
        request.resource.data.redeemedByUid == request.auth.uid &&
        request.resource.data.redeemedByEmail == request.auth.token.email &&
        request.resource.data.redeemSource == "manual_invite_link" &&
        request.resource.data.redeemEntitlementId is string &&
        request.resource.data.redeemAuditId is string &&
        resource.data.accessId is string &&
        existsAfter(
          /databases/$(database)/documents/studentAccess/$(resource.data.accessId)
        ) &&
        getAfter(
          /databases/$(database)/documents/studentAccess/$(resource.data.accessId)
        ).data.uid == request.auth.uid &&
        existsAfter(
          /databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(request.resource.data.redeemEntitlementId)
        ) &&
        existsAfter(
          /databases/$(database)/documents/accessAuditLogs/$(request.resource.data.redeemAuditId)
        ) &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteStudentAccessUpdate() {
      return isSignedIn() &&
        (resource.data.normalizedEmail == request.auth.token.email || resource.data.email == request.auth.token.email) &&
        (!resource.data.keys().hasAny(["uid"]) || resource.data.uid == null || resource.data.uid == "" || resource.data.uid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "inviteId",
          "inviteRedeemedAt",
          "inviteRedeemedByUid",
          "inviteRedeemedByEmail",
          "lastInviteRedeemedAt",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.inviteRedeemedByUid == request.auth.uid &&
        request.resource.data.inviteRedeemedByEmail == request.auth.token.email &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isPendingIdentityClaimUpdate(accessDocId) {
      return isSignedIn() &&
        (
          resource.data.normalizedEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        ) &&
        (
          !resource.data.keys().hasAny(["uid"]) ||
          resource.data.uid == null ||
          resource.data.uid == "" ||
          resource.data.uid == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "identityClaimedAt",
          "identityClaimedByUid",
          "identityClaimedByEmail",
          "identityClaimSource",
          "identityClaimAuditId",
          "identityClaimEntitlementId",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.identityClaimedByUid == request.auth.uid &&
        request.resource.data.identityClaimedByEmail == request.auth.token.email &&
        request.resource.data.identityClaimSource == "verified_uid_claim" &&
        request.resource.data.identityClaimAuditId is string &&
        request.resource.data.identityClaimAuditId != "" &&
        existsAfter(
          /databases/$(database)/documents/accessAuditLogs/$(request.resource.data.identityClaimAuditId)
        ) &&
        getAfter(
          /databases/$(database)/documents/accessAuditLogs/$(request.resource.data.identityClaimAuditId)
        ).data.accessId == accessDocId &&
        (
          request.resource.data.identityClaimEntitlementId == "" ||
          (
            request.resource.data.identityClaimEntitlementId is string &&
            existsAfter(
              /databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(request.resource.data.identityClaimEntitlementId)
            )
          )
        ) &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isIdentityClaimAuditCreate(auditId) {
      return isSignedIn() &&
        request.resource.data.action == "claim_pending_access_identity" &&
        request.resource.data.accessId is string &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "verified_uid_claim" &&
        existsAfter(
          /databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)
        ) &&
        getAfter(
          /databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)
        ).data.uid == request.auth.uid &&
        getAfter(
          /databases/$(database)/documents/studentAccess/$(request.resource.data.accessId)
        ).data.identityClaimAuditId == auditId;
    }

    function isInviteOpenAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "open_access_invite" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "manual_invite_link";
    }

    function isInviteRedeemAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "redeem_access_invite" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "manual_invite_link";
    }

    function isRedeemAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "redeem_access_key" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "redeem_key";
    }

    match /accessProducts/{docId} {
      allow get: if isAdmin() ||
        (
          resource.data.productId == docId &&
          isActivePlanProductData(resource.data)
        );
      allow list: if isAdmin() ||
        (
          resource.data.scopeType == "plan" &&
          resource.data.status == "active" &&
          resource.data.isActive == true
        );
      allow create, update, delete: if isAdmin();
    }

    match /accessKeys/{keyCode} {
      allow read, create, update, delete: if isAdmin();

      allow get: if isSignedIn() &&
        keyCode == resource.data.normalizedCode &&
        isAccessKeyAssignedToRequester();

      allow update: if isAccessKeyRedeemUpdate(keyCode);
    }

    function isStudentEntitlementWrite(uid, entitlementId) {
      let data = request.resource.data;
      let access = getAfter(
        /databases/$(database)/documents/studentAccess/$(data.accessId)
      ).data;
      let accessPlanCode = access.get("planCode", access.planType);
      let accessRank = access.get(
        "accessRank",
        legacyPlanAccessRank(access.planType)
      );
      return isSignedIn() &&
        uid == request.auth.uid &&
        data.keys().hasOnly([
          "id",
          "uid",
          "email",
          "normalizedEmail",
          "accessId",
          "planType",
          "planCode",
          "accessRank",
          "productId",
          "purchaseTermsSnapshot",
          "termsSnapshot",
          "priceVersion",
          "validityMode",
          "noExpiry",
          "untilManualChange",
          "scopeType",
          "module",
          "itemType",
          "itemId",
          "itemIds",
          "bundleId",
          "course",
          "status",
          "source",
          "accessFrom",
          "accessUntil",
          "grantKey",
          "grantFamilyKey",
          "grantRevision",
          "updatedAt"
        ]) &&
        data.keys().size() == 30 &&
        data.id == entitlementId &&
        data.uid == request.auth.uid &&
        data.email == request.auth.token.email &&
        data.normalizedEmail == request.auth.token.email &&
        data.accessId is string &&
        data.accessId != "" &&
        data.planCode == data.planType &&
        data.accessRank is int &&
        data.accessRank >= 0 &&
        data.termsSnapshot == data.purchaseTermsSnapshot &&
        data.noExpiry is bool &&
        data.untilManualChange is bool &&
        !(data.noExpiry && data.untilManualChange) &&
        data.grantRevision is int &&
        data.grantRevision >= 0 &&
        data.updatedAt is timestamp &&
        existsAfter(/databases/$(database)/documents/studentAccess/$(data.accessId)) &&
        (
          access.uid == request.auth.uid ||
          access.normalizedEmail == request.auth.token.email ||
          access.email == request.auth.token.email
        ) &&
        data.planType ==
          access.planType &&
        data.planCode ==
          accessPlanCode &&
        data.accessRank ==
          accessRank &&
        data.productId ==
          access.get("productId", null) &&
        data.purchaseTermsSnapshot ==
          access.get("purchaseTermsSnapshot", null) &&
        data.priceVersion ==
          access.get("priceVersion", null) &&
        data.validityMode ==
          access.get("validityMode", "CUSTOM_WINDOW") &&
        data.noExpiry ==
          access.get("noExpiry", false) &&
        data.untilManualChange ==
          access.get("untilManualChange", false) &&
        data.scopeType ==
          access.scopeType &&
        data.module ==
          access.module &&
        data.itemType ==
          access.itemType &&
        data.itemId ==
          access.itemId &&
        data.itemIds ==
          access.itemIds &&
        data.bundleId ==
          access.bundleId &&
        data.course ==
          access.course &&
        data.status ==
          access.status &&
        data.source ==
          access.source &&
        data.accessFrom ==
          access.accessFrom &&
        data.accessUntil ==
          access.accessUntil &&
        data.grantKey ==
          access.get("grantKey", null) &&
        data.grantFamilyKey ==
          access.get("grantFamilyKey", null) &&
        data.grantRevision ==
          access.get("grantRevision", 0);
    }

    match /studentAccess/{docId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          (
            resource.data.uid == request.auth.uid ||
            resource.data.normalizedEmail == request.auth.token.email ||
            resource.data.email == request.auth.token.email
          )
        );

      allow create: if isAdmin() || isRedeemStudentAccessCreate(docId);
      allow update: if
        isAdmin() ||
        isInviteStudentAccessUpdate() ||
        isPendingIdentityClaimUpdate(docId);
      allow delete: if isAdmin();
    }
    match /studentEntitlements/{uid}/items/{entitlementId} {
      allow read: if isAdmin() || (isSignedIn() && uid == request.auth.uid);
      allow create, update: if isAdmin() || isStudentEntitlementWrite(uid, entitlementId);
      allow delete: if isAdmin();
    }

    match /accessInvites/{docId} {
      allow read: if isAdmin() || isInviteOwnRecord();
      allow create: if isAdmin();
      allow update: if isAdmin() || isInviteOpenUpdate(docId) || isInviteRedeemUpdate(docId);
      allow delete: if isAdmin();
    }

    match /accessAuditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if
        isAdmin() ||
        isRedeemAuditCreate() ||
        isInviteOpenAuditCreate() ||
        isInviteRedeemAuditCreate() ||
        isIdentityClaimAuditCreate(docId);
      allow update, delete: if false;
    }

    /* ================================
       Access Engine — Future Admin Workflows
       ================================ */

    match /accessBulkImports/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessBulkImportRows/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessEmailQueue/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessNotifications/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessPlanHistory/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /accessActionLogs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
