{
  "version": "1.1.0",
  "requiredDependencies": [
    "auth",
    "signInWithEmailAndPassword",
    "signInWithPopup",
    "signOut",
    "onAuthStateChanged",
    "GoogleAuthProvider",
    "roleExperienceDependencyAdapter"
  ],
  "roleAdapterMethods": [
    "loadAccountProfile",
    "resolveRole",
    "resolveAllowedExperiences"
  ],
  "googleProvider": {
    "customParameters": {
      "prompt": "select_account"
    }
  },
  "authServiceDependencies": [
    "auth",
    "signInWithEmailAndPassword",
    "signInWithPopup",
    "signOut",
    "subscribeAuthState",
    "createGoogleProvider",
    "loadAccountProfile",
    "resolveRole",
    "resolveAllowedExperiences"
  ],
  "authoritativeSession": {
    "source": "reviewed_auth_service_getSession",
    "callerSessionTrusted": false,
    "factory": "createAuthoritativeSessionReader",
    "listener": {
      "source": "reviewed_auth_service_subscribeSession",
      "sdkDependency": "onAuthStateChanged",
      "callerSessionTrusted": false,
      "unsubscribeRequired": true
    }
  },
  "forbidden": {
    "navigation": true,
    "domStorage": true,
    "profileWrites": true,
    "roleFromCallerProfile": true
  }
}
