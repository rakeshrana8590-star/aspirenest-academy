{
  "version": "1.2.0",
  "requiredDependencies": [
    "auth",
    "signInWithEmailAndPassword",
    "signInWithPopup",
    "signOut",
    "onAuthStateChanged",
    "GoogleAuthProvider",
    "roleExperienceDependencyAdapter",
    "sendEmailVerification",
    "sendPasswordResetEmail",
    "reload",
    "getLocationOrigin"
  ],
  "roleAdapterMethods": [
    "loadAccountProfile",
    "resolveRole",
    "resolveAllowedExperiences"
  ],
  "googleProvider": {
    "customParameters": {
      "prompt": "select_account"
    }
  },
  "authServiceDependencies": [
    "auth",
    "signInWithEmailAndPassword",
    "signInWithPopup",
    "signOut",
    "subscribeAuthState",
    "createGoogleProvider",
    "loadAccountProfile",
    "resolveRole",
    "resolveAllowedExperiences",
    "sendEmailVerification",
    "sendPasswordResetEmail",
    "reloadUser",
    "buildActionCodeSettings"
  ],
  "authoritativeSession": {
    "source": "reviewed_auth_service_getSession",
    "callerSessionTrusted": false,
    "factory": "createAuthoritativeSessionReader",
    "listener": {
      "source": "reviewed_auth_service_subscribeSession",
      "sdkDependency": "onAuthStateChanged",
      "callerSessionTrusted": false,
      "unsubscribeRequired": true
    }
  },
  "forbidden": {
    "navigation": true,
    "domStorage": true,
    "profileWrites": true,
    "roleFromCallerProfile": true
  },
  "emailActions": {
    "verification": {
      "provider": "firebase_auth",
      "continueRoute": "#public/auth/verify",
      "verifiedOnly": true,
      "hostedActionHandler": true
    },
    "passwordReset": {
      "provider": "firebase_auth",
      "neutralResponse": true,
      "preserveReturnTo": true,
      "hostedActionHandler": true
    },
    "externalReturnToAllowed": false
  }
}
