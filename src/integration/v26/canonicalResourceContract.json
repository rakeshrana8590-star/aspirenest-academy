  "routePolicy": {
    "maxLength": 2048,
    "allowHashPrefix": true,
    "requireLeadingSlash": true,
    "rejectTraversal": true,
    "decodePasses": 8,
    "rejectDotSegments": true,
    "validateHashRoute": true,
    "validateDerivedRoutes": true
  },
  "collectionTypePolicy": {
    "studyRoadmaps": {
      "allowedTypes": [
        "roadmap"
      ],
      "defaultType": "roadmap"
    },
    "mentorLiveSessions": {
      "allowedTypes": [
        "live",
        "replay"
      ],
      "defaultType": "live"
    },
    "experienceEvents": {
      "allowedTypes": [
        "live",
        "replay",
        "test"
      ],
      "defaultType": null
    },
    "contentItems": {
      "allowedTypes": [
        "note",
        "video",
        "test",
        "current-affairs",
        "roadmap",
        "live",
        "replay"
      ],
      "defaultType": null
    }
  },
  "eventTargetFields": [
    "targetResourceId",
    "resourceTarget",
    "targetId",
    "testId",
    "mockTestId",
    "itemId",
    "target"
  ],
  "identityPolicy": {
    "maxLength": 256,
    "rejectDotSegments": true,
    "decodePasses": 8,
    "requireReaderIdentityAgreement": true
  },
  "eventTargetPolicy": {
    "maxLength": 256,
    "requireAllDefinedTargetsToAgree": true,
    "validateAsResourceId": true,
    "validateEvenWithExplicitRoute": true,
    "requireCanonicalRouteAgreement": true
  },
  "requestPolicy": {
    "sanitizePropertyAccess": true,
    "sanitizeStringCoercion": true
  },
  "planPolicy": {
    "requireExplicitPlanForCollections": [
      "contentItems",
      "studyRoadmaps",
      "experienceEvents"
    ],
    "allowIsPremiumBooleanSignal": true,
    "defaultPlanCollections": {
      "mentorLiveSessions": "MENTORSHIP"
    }
  },
  "resourceTypeCompatibilityAlias": "type",
  "stableIdentityPolicy": "resourceId is canonical; legacy ids remain aliases only"
}
