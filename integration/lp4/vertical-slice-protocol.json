        "WATCH",
        "DOWNLOAD"
      ],
      "requirements": [
        "protected resolver",
        "no reusable premium URL",
        "captions/transcript",
        "server progress",
        "provider failure recovery"
      ]
    },
    "4.5": {
      "name": "Live Classes + Replays",
      "actions": [
        "JOIN",
        "WATCH"
      ],
      "requirements": [
        "server-time join window",
        "protected join delivery",
        "server attendance",
        "replay independent authorization",
        "cancel/reschedule recovery"
      ]
    },
    "4.6": {
      "name": "AspirePath Roadmaps + assignments",
      "actions": [
        "READ"
      ],
      "requirements": [
        "server progress",
        "catch-up/reschedule",
        "linked resource independent authorization",
        "assignment not entitlement"
      ]
    },
    "4.7": {
      "name": "Discovery / Saved / Recent / Continue / progress",
      "actions": [
        "READ"
      ],
      "requirements": [
        "role-safe canonical search",
        "saved/recent/continue server truth",
        "exact cursor",
        "no stale duplicate routes",
        "reauthorize on open"
      ]
    }
  },
