rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "aspirenestplatform@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProgressOwner() {
      return isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
    }

    function isExistingProgressOwner() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    match /students/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create: if isOwner(userId) || isAdmin();

      allow read: if isOwner(userId) || isAdmin();

      allow update: if isOwner(userId)
        && request.resource.data.isPremium == resource.data.isPremium
        && request.resource.data.subscriptionType == resource.data.subscriptionType
        && request.resource.data.premiumStatus == resource.data.premiumStatus;

      allow update: if isAdmin() || isInviteStudentAccessUpdate();
      allow delete: if isAdmin();
    }

    /* ================================
       Learner Profile / Biodata System
       ================================ */

    function isLearnerProfileOwnerExisting(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          resource.data.uid == request.auth.uid ||
          resource.data.normalizedEmail == request.auth.token.email ||
          resource.data.email == request.auth.token.email
        );
    }

    function isLearnerProfileOwnerRequest(profileId) {
      return isSignedIn() &&
        (
          profileId == request.auth.uid ||
          request.resource.data.uid == request.auth.uid ||
          request.resource.data.normalizedEmail == request.auth.token.email ||
          request.resource.data.email == request.auth.token.email
        );
    }

    function studentProfileIdentitySafe() {
      return request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.role == "student" &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function studentProfileCreateKeysOnly() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
        "authProvider",
        "emailVerified",
        "lastLoginAt",
        "profileCompletion",
        "profileMissingFields",
        "profileStatus",
        "source",
        "updatedAt",
        "updatedBy",
        "createdAt",
        "createdBy"
      ]);
    }

    function studentProfileUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "uid",
        "email",
        "normalizedEmail",
        "role",
        "name",
        "phone",
        "targetExam",
        "state",
        "city",
        "language",
        "authProvider",
        "emailVerified",
        "lastLoginAt",
        "profileCompletion",
        "profileMissingFields",
        "profileStatus",
        "source",
        "updatedAt",
        "updatedBy",
        "createdAt",
        "createdBy"
      ]);
    }

    match /learnerProfiles/{profileId} {
      allow create: if isAdmin() ||
        (
          isLearnerProfileOwnerRequest(profileId) &&
          studentProfileIdentitySafe() &&
          studentProfileCreateKeysOnly()
        );

      allow read: if isAdmin() || isLearnerProfileOwnerExisting(profileId);

      allow update: if isAdmin() ||
        (
          isLearnerProfileOwnerExisting(profileId) &&
          isLearnerProfileOwnerRequest(profileId) &&
          studentProfileIdentitySafe() &&
          studentProfileUpdateKeysOnly()
        );

      allow delete: if isAdmin();
    }

    match /enquiries/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    /* === P0 protected entitlement fixed-window enforcement v2 === */
    function isProtectedEntitlementWindowValid(entitlement) {
      return entitlement.status == "active" &&
        entitlement.uid == request.auth.uid &&
        entitlement.accessId is string &&
        entitlement.accessId != "" &&
        entitlement.accessFrom is timestamp &&
        entitlement.accessUntil is timestamp &&
        entitlement.accessFrom < entitlement.accessUntil &&
        entitlement.validityMode == "fixed_window" &&
        entitlement.validityPolicy == "fixed_window" &&
        request.time >= entitlement.accessFrom &&
        request.time <= entitlement.accessUntil;
    }

    function hasMatchingProtectedStudentAccess(entitlement) {
      let accessId = entitlement.accessId;
      let accessPath =
        /databases/$(database)/documents/studentAccess/$(accessId);

      return accessId is string &&
        accessId != "" &&
        exists(accessPath) &&
        get(accessPath).data.status == "active" &&
        get(accessPath).data.uid == request.auth.uid &&
        get(accessPath).data.planType == entitlement.planType &&
        get(accessPath).data.scopeType == entitlement.scopeType &&
        get(accessPath).data.get("module", null) ==
          entitlement.get("module", null) &&
        get(accessPath).data.get("itemType", null) ==
          entitlement.get("itemType", null) &&
        get(accessPath).data.get("itemId", null) ==
          entitlement.get("itemId", null) &&
        get(accessPath).data.get("itemIds", []) ==
          entitlement.get("itemIds", []) &&
        get(accessPath).data.get("bundleId", null) ==
          entitlement.get("bundleId", null) &&
        get(accessPath).data.course == entitlement.course &&
        get(accessPath).data.source == entitlement.source &&
        get(accessPath).data.accessFrom is timestamp &&
        get(accessPath).data.accessUntil is timestamp &&
        get(accessPath).data.accessFrom ==
          entitlement.accessFrom &&
        get(accessPath).data.accessUntil ==
          entitlement.accessUntil &&
        get(accessPath).data.validityMode == "fixed_window" &&
        get(accessPath).data.validityPolicy == "fixed_window";
    }

    function hasProtectedStudentEntitlement(entitlementId) {
      let entitlementPath =
        /databases/$(database)/documents/studentEntitlements/$(request.auth.uid)/items/$(entitlementId);

      return isSignedIn() &&
        entitlementId is string &&
        entitlementId != "" &&
        exists(entitlementPath) &&
        isProtectedEntitlementWindowValid(
          get(entitlementPath).data
        ) &&
        hasMatchingProtectedStudentAccess(
          get(entitlementPath).data
        );
    }

    function hasProtectedPlanEntitlement(planType) {
      return planType == "FREE" ||
        (
          planType == "BASIC" &&
          (
            hasProtectedStudentEntitlement("plan_BASIC") ||
            hasProtectedStudentEntitlement("plan_PREMIUM") ||
            hasProtectedStudentEntitlement("plan_MENTORSHIP")
          )
        ) ||
        (
          planType == "PREMIUM" &&
          (
            hasProtectedStudentEntitlement("plan_PREMIUM") ||
            hasProtectedStudentEntitlement("plan_MENTORSHIP")
          )
        ) ||
        (
          planType == "MENTORSHIP" &&
          hasProtectedStudentEntitlement("plan_MENTORSHIP")
        );
    }

    function isProtectedAnswerMirror() {
      return resource.data.sourceCollection == "contentItems" &&
        resource.data.get("answerEntries", []) is list &&
        resource.data.get("answerEntries", []).size() > 0;
    }

    function hasProtectedAssetAccess(asset) {
      return asset.planType == "FREE" ||
        (
          isSignedIn() &&
          (
            (
              asset.get("requiredEntitlementId", "") is string &&
              asset.get("requiredEntitlementId", "") != "" &&
              hasProtectedStudentEntitlement(
                asset.get("requiredEntitlementId", "")
              )
            ) ||
            hasProtectedPlanEntitlement(asset.planType)
          )
        );
    }

    function hasSubmittedMockReceipt(testId, assetId) {
      let receiptPath =
        /databases/$(database)/documents/mockSubmissionReceipts/$(request.auth.uid)/tests/$(testId);

      return isSignedIn() &&
        testId is string &&
        testId != "" &&
        assetId is string &&
        assetId != "" &&
        exists(receiptPath) &&
        get(receiptPath).data.uid == request.auth.uid &&
        get(receiptPath).data.testId == testId &&
        get(receiptPath).data.assetId == assetId &&
        get(receiptPath).data.sourceCollection == "contentItems" &&
        get(receiptPath).data.status == "submitted" &&
        get(receiptPath).data.schemaVersion == 1 &&
        get(receiptPath).data.submittedAt is timestamp;
    }

    function canSubmitMockReceipt(testId, assetId) {
      let assetPath =
        /databases/$(database)/documents/protectedContentAssets/$(assetId);

      return isSignedIn() &&
        testId is string &&
        testId != "" &&
        assetId is string &&
        assetId != "" &&
        exists(assetPath) &&
        get(assetPath).data.id == assetId &&
        get(assetPath).data.status == "published" &&
        get(assetPath).data.sourceCollection == "contentItems" &&
        get(assetPath).data.sourceId == testId &&
        get(assetPath).data.get("answerEntries", []) is list &&
        get(assetPath).data.get("answerEntries", []).size() > 0 &&
        hasProtectedAssetAccess(get(assetPath).data);
    }

    function canReadProtectedContentAsset(assetId) {
      return resource.data.status == "published" &&
        (
          (
            isProtectedAnswerMirror() &&
            isSignedIn() &&
            hasSubmittedMockReceipt(
              resource.data.sourceId,
              assetId
            )
          ) ||
          (
            !isProtectedAnswerMirror() &&
            hasProtectedAssetAccess(resource.data)
          )
        );
    }

    match /protectedContentAssets/{assetId} {
      allow read: if isAdmin() || canReadProtectedContentAsset(assetId);
      allow create, update, delete: if isAdmin();
    }

    function isPublishedPublicContent() {
      return resource.data.status == "published" &&
        resource.data.sourceCollection == "contentItems" &&
        resource.data.publicSchemaVersion == 1;
    }

    function isCanonicalPublicContentWrite(docId) {
      return request.resource.data.id == docId &&
        request.resource.data.sourceId == docId &&
        request.resource.data.sourceCollection == "contentItems" &&
        request.resource.data.status == "published" &&
        request.resource.data.publicSchemaVersion == 1;
    }

    match /contentItemsPublic/{docId} {
      allow get: if isPublishedPublicContent() &&
        resource.data.id == docId &&
        resource.data.sourceId == docId;

      allow list: if isPublishedPublicContent();

      allow create, update: if isAdmin() &&
        isCanonicalPublicContentWrite(docId);

      allow delete: if isAdmin();
    }

    match /contentItems/{docId} {
      // Phase 1 compatibility only: preserve current live raw catalog reads
      // until the public-catalog application bundle is deployed and verified.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /universalContent/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }


    match /experienceEvents/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* === P0 mock UID ownership v1 === */
    match /mockSubmissionReceipts/{uid}/tests/{testId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          request.auth.uid == uid
        );

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          "uid",
          "testId",
          "assetId",
          "sourceCollection",
          "status",
          "attemptKey",
          "startedAt",
          "submittedAt",
          "reason",
          "schemaVersion",
          "updatedAt"
        ])
        && request.resource.data.uid == uid
        && request.resource.data.testId == testId
        && request.resource.data.assetId is string
        && request.resource.data.assetId != ""
        && request.resource.data.sourceCollection == "contentItems"
        && request.resource.data.status == "submitted"
        && request.resource.data.attemptKey is string
        && request.resource.data.attemptKey != ""
        && request.resource.data.startedAt is number
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reason is string
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt == request.time
        && canSubmitMockReceipt(
          testId,
          request.resource.data.assetId
        );

      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.uid == uid
        && resource.data.testId == testId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.testId == resource.data.testId
        && request.resource.data.assetId == resource.data.assetId
        && request.resource.data.sourceCollection ==
          resource.data.sourceCollection
        && request.resource.data.schemaVersion ==
          resource.data.schemaVersion
        && request.resource.data.status == "submitted"
        && request.resource.data.attemptKey is string
        && request.resource.data.attemptKey != ""
        && request.resource.data.startedAt is number
        && request.resource.data.submittedAt == request.time
        && request.resource.data.reason is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "attemptKey",
          "startedAt",
          "submittedAt",
          "reason",
          "updatedAt"
        ])
        && canSubmitMockReceipt(
          testId,
          request.resource.data.assetId
        );

      allow delete: if isAdmin();
    }

    match /mockResults/{docId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.studentEmail == request.auth.token.email
        && request.resource.data.testId is string
        && request.resource.data.testId != ""
        && request.resource.data.attemptKey is string
        && request.resource.data.attemptKey != "";

      allow read: if isAdmin() ||
        (
          isSignedIn()
          && resource.data.uid == request.auth.uid
        );

      allow update: if isAdmin() ||
        (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.studentEmail ==
            resource.data.studentEmail
          && request.resource.data.testId == resource.data.testId
          && request.resource.data.attemptKey ==
            resource.data.attemptKey
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "testTitle",
            "score",
            "totalMarks",
            "percentage",
            "accuracy",
            "correctCount",
            "wrongCount",
            "skippedCount",
            "totalQuestions",
            "durationSeconds",
            "updatedAt"
          ])
        );

      allow delete: if isAdmin();
    }

    match /mockLeaderboard/{docId} {
      allow read: if isAdmin() ||
        (
          isSignedIn()
          && resource.data.uid == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.studentEmail ==
          request.auth.token.email
        && request.resource.data.leaderboardKey is string
        && request.resource.data.leaderboardKey != ""
        && request.resource.data.testId is string
        && request.resource.data.testId != "";

      allow update: if isAdmin() ||
        (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.studentEmail ==
            resource.data.studentEmail
          && request.resource.data.leaderboardKey ==
            resource.data.leaderboardKey
          && request.resource.data.testId == resource.data.testId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "testTitle",
            "score",
            "totalMarks",
            "percentage",
            "accuracy",
            "correctCount",
            "wrongCount",
            "skippedCount",
            "totalQuestions",
            "durationSeconds",
            "rankScore",
            "rankTieBreakerScore",
            "attemptId",
            "attemptStartedAt",
            "attemptSubmittedAt",
            "attemptNumber",
            "startedAt",
            "endedAt",
            "updatedAt"
          ])
          && (
            request.resource.data.get("rankScore", 0) >
              resource.data.get("rankScore", 0)
            || (
              request.resource.data.get("rankScore", 0) ==
                resource.data.get("rankScore", 0)
              && request.resource.data.get(
                "rankTieBreakerScore",
                0
              ) >
                resource.data.get("rankTieBreakerScore", 0)
            )
            || (
              resource.data.get("attemptId", "") != ""
              && request.resource.data.get("attemptId", "") ==
                resource.data.get("attemptId", "")
            )
          )
        );

      allow delete: if isAdmin();
    }

    /* === P0 phase6h-a privacy cutover v1 === */
    function canWritePublicMockLeaderboard(docId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/mockLeaderboard/$(docId)) &&
        get(/databases/$(database)/documents/mockLeaderboard/$(docId)).data.uid ==
          request.auth.uid;
    }

    function publicMockLeaderboardPayloadSafe(docId) {
      let raw = get(
        /databases/$(database)/documents/mockLeaderboard/$(docId)
      ).data;

      return request.resource.data.keys().hasOnly([
          "leaderboardKey",
          "leaderboardMode",
          "testId",
          "testTitle",
          "displayName",
          "score",
          "totalMarks",
          "percentage",
          "accuracy",
          "correctCount",
          "wrongCount",
          "skippedCount",
          "totalQuestions",
          "durationSeconds",
          "rankScore",
          "rankTieBreakerScore",
          "attemptNumber",
          "attemptStartedAt",
          "attemptSubmittedAt",
          "startedAt",
          "endedAt",
          "createdAt",
          "updatedAt",
          "planType",
          "status"
        ]) &&
        request.resource.data.status == "published" &&
        request.resource.data.testId == raw.testId &&
        request.resource.data.leaderboardKey ==
          raw.leaderboardKey &&
        request.resource.data.testTitle ==
          raw.get("testTitle", "") &&
        request.resource.data.leaderboardMode ==
          raw.get("leaderboardMode", "") &&
        request.resource.data.planType ==
          raw.get("planType", "FREE") &&
        (
          request.resource.data.displayName ==
            raw.get("studentName", "") ||
          request.resource.data.displayName ==
            "AspireNest Learner"
        ) &&
        request.resource.data.score ==
          raw.get("score", 0) &&
        request.resource.data.totalMarks ==
          raw.get("totalMarks", 0) &&
        request.resource.data.percentage ==
          raw.get("percentage", 0) &&
        request.resource.data.accuracy ==
          raw.get("accuracy", 0) &&
        request.resource.data.correctCount ==
          raw.get("correctCount", 0) &&
        request.resource.data.wrongCount ==
          raw.get("wrongCount", 0) &&
        request.resource.data.skippedCount ==
          raw.get("skippedCount", 0) &&
        request.resource.data.totalQuestions ==
          raw.get("totalQuestions", 0) &&
        request.resource.data.durationSeconds ==
          raw.get("durationSeconds", 0) &&
        request.resource.data.rankScore ==
          raw.get("rankScore", raw.get("percentage", 0)) &&
        request.resource.data.rankTieBreakerScore ==
          raw.get("rankTieBreakerScore", raw.get("score", 0));
    }

    match /mockLeaderboardPublic/{docId} {
      allow read: if resource.data.status == "published";

      allow create, update: if isAdmin() ||
        (
          canWritePublicMockLeaderboard(docId) &&
          publicMockLeaderboardPayloadSafe(docId)
        );

      allow delete: if isAdmin();
    }



    match /questionBank/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /mockQuestions/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /notesSubjects/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notesChapters/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notes/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /currentAffairs/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /payments/{docId} {
      function isPaymentOwner() {
        return isSignedIn() && resource.data.userId == request.auth.uid;
      }

      function isNewPaymentOwner() {
        return isSignedIn() && request.resource.data.userId == request.auth.uid;
      }

      function isStudentPaymentCreate() {
        return isNewPaymentOwner() &&
          request.resource.data.keys().hasOnly([
            "orderId",
            "userId",
            "upiLink",
            "studentEmail",
            "studentMobile",
            "studentName",
            "planName",
            "amount",
            "status",
            "studentProof",
            "adminProof",
            "matchStatus",
            "createdAt"
          ]) &&
          request.resource.data.status == "pending_payment" &&
          request.resource.data.studentProof == "" &&
          request.resource.data.adminProof == "" &&
          request.resource.data.matchStatus == "waiting";
      }

      function isStudentProofSubmit() {
        return isPaymentOwner() &&
          resource.data.status in ["pending_payment", "student_proof_submitted"] &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "studentProof",
            "status",
            "updatedAt"
          ]) &&
          request.resource.data.status == "student_proof_submitted" &&
          request.resource.data.studentProof is string &&
          request.resource.data.studentProof.size() > 0;
      }

      allow create: if isAdmin() || isStudentPaymentCreate();

      allow read: if isAdmin() || isPaymentOwner();

      allow update: if isAdmin() || isStudentProofSubmit();

      allow delete: if isAdmin();
    }

    match /banners/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pricingPlans/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studentActivity/{docId} {
      allow create: if isSignedIn();

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.userId);

      allow update, delete: if isAdmin();
    }

    /* ================================
       AspirePath / Roadmap Studio
       ================================ */

    match /studyRoadmaps/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapDays/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapResourceLinks/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /studyRoadmapProgress/{docId} {
      allow create: if isProgressOwner();

      allow read: if isAdmin() || isExistingProgressOwner();

      allow update: if isAdmin() ||
        (
          isExistingProgressOwner() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.roadmapId == resource.data.roadmapId &&
          request.resource.data.dayId == resource.data.dayId
        );

      allow delete: if isAdmin();
    }

    match /studyRoadmapAnalytics/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    /* ================================
       Access Engine
       ================================ */

    function isRedeemEmailMatch(emailValue) {
      return emailValue == request.auth.token.email;
    }

    function isAccessKeyAssignedToRequester() {
      return resource.data.assignedEmail == null ||
        resource.data.assignedEmail == "" ||
        resource.data.assignedEmail == request.auth.token.email;
    }

    function isAccessKeyRedeemUpdate(keyCode) {
      return isSignedIn() &&
        keyCode == resource.data.normalizedCode &&
        resource.data.status == "active" &&
        resource.data.usedCount < resource.data.maxUses &&
        isAccessKeyAssignedToRequester() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "usedCount",
          "status",
          "lastRedeemedByEmail",
          "lastRedeemedByUid",
          "lastRedeemedAt",
          "redeemedByEmail",
          "redeemedByUid",
          "redeemedAt",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.usedCount == resource.data.usedCount + 1 &&
        (
          (
            request.resource.data.usedCount < request.resource.data.maxUses &&
            request.resource.data.status == "active"
          ) ||
          (
            request.resource.data.usedCount >= request.resource.data.maxUses &&
            request.resource.data.status == "used"
          )
        ) &&
        request.resource.data.lastRedeemedByEmail == request.auth.token.email &&
        request.resource.data.lastRedeemedByUid == request.auth.uid &&
        (
          request.resource.data.redeemedByEmail == resource.data.redeemedByEmail ||
          request.resource.data.redeemedByEmail == request.auth.token.email
        ) &&
        (
          request.resource.data.redeemedByUid == resource.data.redeemedByUid ||
          request.resource.data.redeemedByUid == request.auth.uid
        ) &&
        request.resource.data.updatedBy == request.auth.uid;
    }

      function isRedeemDirectKeyAccessMatches(accessKeyId) {
        let key = get(/databases/$(database)/documents/accessKeys/$(accessKeyId)).data;

        return (key.productId == null || key.productId == "") &&
          key.accessUntil != null &&
          key.accessUntil != "" &&
          request.resource.data.productId == key.productId &&
          request.resource.data.course == key.course &&
          request.resource.data.planType == key.planType &&
          request.resource.data.scopeType == key.scopeType &&
          request.resource.data.module == key.module &&
          request.resource.data.itemType == key.itemType &&
          request.resource.data.itemId == key.itemId &&
          request.resource.data.itemIds == key.itemIds &&
          request.resource.data.bundleId == key.bundleId &&
          request.resource.data.accessUntil == key.accessUntil;
      }

      function isRedeemProductAccessMatches(accessKeyId) {
        let key = get(/databases/$(database)/documents/accessKeys/$(accessKeyId)).data;
        let product = get(/databases/$(database)/documents/accessProducts/$(key.productId)).data;

        return key.productId is string &&
          key.productId != "" &&
          exists(/databases/$(database)/documents/accessProducts/$(key.productId)) &&
          product.status == "active" &&
          product.isActive != false &&
          request.resource.data.productId == key.productId &&
          request.resource.data.course == product.course &&
          request.resource.data.planType == product.planType &&
          request.resource.data.scopeType == product.scopeType &&
          request.resource.data.module == product.module &&
          request.resource.data.itemType == product.itemType &&
          request.resource.data.itemId == product.itemId &&
          request.resource.data.itemIds == product.itemIds &&
          product.accessUntil != null &&
          product.accessUntil != "" &&
          request.resource.data.bundleId == product.bundleId &&
          request.resource.data.accessUntil == product.accessUntil;
      }

    function isRedeemStudentAccessCreate() {
      return isSignedIn() &&
        request.resource.data.keys().hasOnly([
          "email",
          "normalizedEmail",
          "uid",
          "planType",
          "scopeType",
          "status",
          "source",
          "course",
          "module",
          "itemType",
          "itemId",
          "itemTitle",
          "itemIds",
          "bundleId",
          "productId",
          "accessKeyId",
          "campaignId",
          "campaignName",
          "campaignSource",
          "learnerName",
          "name",
          "phone",
          "accessFrom",
          "accessUntil",
          "notes",
          "adminNote",
          "updatedAt",
          "createdAt",
          "createdBy",
          "actorEmail"
        ]) &&
        request.resource.data.keys().hasAll([
          "email",
          "normalizedEmail",
          "uid",
          "planType",
          "scopeType",
          "status",
          "source",
          "course",
          "accessKeyId",
          "updatedAt",
          "createdAt",
          "createdBy",
          "actorEmail"
        ]) &&
        request.resource.data.source == "redeem_key" &&
        request.resource.data.status == "active" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.normalizedEmail == request.auth.token.email &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.accessKeyId is string &&
        exists(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)) &&
        get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.status == "active" &&
        get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.usedCount <
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.maxUses &&
        (
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.assignedEmail == null ||
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.assignedEmail == "" ||
          get(/databases/$(database)/documents/accessKeys/$(request.resource.data.accessKeyId)).data.assignedEmail == request.auth.token.email
          ) &&
          (
            isRedeemDirectKeyAccessMatches(request.resource.data.accessKeyId) ||
            isRedeemProductAccessMatches(request.resource.data.accessKeyId)
          );
    }

    function isInviteOwnRecord() {
      return isSignedIn() && (
        resource.data.normalizedEmail == request.auth.token.email ||
        resource.data.email == request.auth.token.email
      );
    }

    function isInviteOpenUpdate(inviteCode) {
      return isInviteOwnRecord() &&
        inviteCode == resource.data.inviteCode &&
        request.time < resource.data.expiresAt &&
        resource.data.inviteStatus in ["pending", "copied", "sent"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "inviteStatus",
          "openedAt",
          "openedByUid",
          "openedByEmail",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.inviteStatus == "opened" &&
        request.resource.data.openedByUid == request.auth.uid &&
        request.resource.data.openedByEmail == request.auth.token.email &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteRedeemUpdate(inviteCode) {
      return isInviteOwnRecord() &&
        inviteCode == resource.data.inviteCode &&
        request.time < resource.data.expiresAt &&
        resource.data.inviteStatus in ["pending", "copied", "sent", "opened"] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "inviteStatus",
          "usedAt",
          "redeemedByUid",
          "redeemedByEmail",
          "redeemSource",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.inviteStatus == "used" &&
        request.resource.data.redeemedByUid == request.auth.uid &&
        request.resource.data.redeemedByEmail == request.auth.token.email &&
        request.resource.data.redeemSource == "manual_invite_link" &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteStudentAccessUpdate() {
      return isSignedIn() &&
        (resource.data.normalizedEmail == request.auth.token.email || resource.data.email == request.auth.token.email) &&
        (!resource.data.keys().hasAny(["uid"]) || resource.data.uid == null || resource.data.uid == "" || resource.data.uid == request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "uid",
          "inviteId",
          "inviteRedeemedAt",
          "inviteRedeemedByUid",
          "inviteRedeemedByEmail",
          "lastInviteRedeemedAt",
          "updatedAt",
          "updatedBy"
        ]) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.inviteRedeemedByUid == request.auth.uid &&
        request.resource.data.inviteRedeemedByEmail == request.auth.token.email &&
        request.resource.data.updatedBy == request.auth.uid;
    }

    function isInviteOpenAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "open_access_invite" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "manual_invite_link";
    }

    function isInviteRedeemAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "redeem_access_invite" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "manual_invite_link";
    }

    function isRedeemAuditCreate() {
      return isSignedIn() &&
        request.resource.data.action == "redeem_access_key" &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.actorEmail == request.auth.token.email &&
        request.resource.data.actorRole == "student" &&
        request.resource.data.metadata.source == "redeem_key";
    }

    match /accessProducts/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessKeys/{keyCode} {
      allow read, create, update, delete: if isAdmin();

      allow get: if isSignedIn() &&
        keyCode == resource.data.normalizedCode &&
        isAccessKeyAssignedToRequester();

      allow update: if isAccessKeyRedeemUpdate(keyCode);
    }

    function isStudentEntitlementWrite(uid, entitlementId) {
      let accessPath =
        /databases/$(database)/documents/studentAccess/$(request.resource.data.accessId);

      return isSignedIn() &&
        uid == request.auth.uid &&
        request.auth.token.email is string &&
        request.resource.data.keys().hasOnly([
          "id",
          "uid",
          "email",
          "normalizedEmail",
          "accessId",
          "planType",
          "scopeType",
          "module",
          "itemType",
          "itemId",
          "itemIds",
          "bundleId",
          "course",
          "status",
          "source",
          "accessFrom",
          "accessUntil",
          "validityMode",
          "validityPolicy",
          "authorizationSchemaVersion",
          "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "id",
          "uid",
          "email",
          "normalizedEmail",
          "accessId",
          "planType",
          "scopeType",
          "module",
          "itemType",
          "itemId",
          "itemIds",
          "bundleId",
          "course",
          "status",
          "source",
          "accessFrom",
          "accessUntil",
          "validityMode",
          "validityPolicy",
          "authorizationSchemaVersion",
          "updatedAt"
        ]) &&
        request.resource.data.id == entitlementId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email ==
          request.auth.token.email &&
        request.resource.data.normalizedEmail ==
          request.auth.token.email &&
        request.resource.data.accessId is string &&
        request.resource.data.accessId != "" &&
        request.resource.data.status == "active" &&
        request.resource.data.accessFrom is timestamp &&
        request.resource.data.accessUntil is timestamp &&
        request.resource.data.accessFrom <
          request.resource.data.accessUntil &&
        request.resource.data.validityMode ==
          "fixed_window" &&
        request.resource.data.validityPolicy ==
          "fixed_window" &&
        request.resource.data.authorizationSchemaVersion == 2 &&
        request.time <
          request.resource.data.accessUntil &&
        exists(accessPath) &&
        (
          get(accessPath).data.uid ==
            request.auth.uid ||
          get(accessPath).data.normalizedEmail ==
            request.auth.token.email ||
          get(accessPath).data.email ==
            request.auth.token.email
        ) &&
        get(accessPath).data.status == "active" &&
        get(accessPath).data.accessFrom is timestamp &&
        get(accessPath).data.accessUntil is timestamp &&
        get(accessPath).data.accessFrom <
          get(accessPath).data.accessUntil &&
        get(accessPath).data.validityMode ==
          "fixed_window" &&
        get(accessPath).data.validityPolicy ==
          "fixed_window" &&
        get(accessPath).data.get(
          "authorizationSchemaVersion",
          2
        ) ==
          request.resource.data.authorizationSchemaVersion &&
        request.resource.data.planType ==
          get(accessPath).data.planType &&
        request.resource.data.scopeType ==
          get(accessPath).data.scopeType &&
        request.resource.data.module ==
          get(accessPath).data.get("module", null) &&
        request.resource.data.itemType ==
          get(accessPath).data.get("itemType", null) &&
        request.resource.data.itemId ==
          get(accessPath).data.get("itemId", null) &&
        request.resource.data.itemIds ==
          get(accessPath).data.get("itemIds", []) &&
        request.resource.data.bundleId ==
          get(accessPath).data.get("bundleId", null) &&
        request.resource.data.course ==
          get(accessPath).data.course &&
        request.resource.data.source ==
          get(accessPath).data.source &&
        request.resource.data.accessFrom ==
          get(accessPath).data.accessFrom &&
        request.resource.data.accessUntil ==
          get(accessPath).data.accessUntil &&
        request.resource.data.validityMode ==
          get(accessPath).data.validityMode &&
        request.resource.data.validityPolicy ==
          get(accessPath).data.validityPolicy;
    }

    match /studentAccess/{docId} {
      allow read: if isAdmin() ||
        (
          isSignedIn() &&
          (
            resource.data.uid == request.auth.uid ||
            resource.data.normalizedEmail == request.auth.token.email ||
            resource.data.email == request.auth.token.email
          )
        );

      allow create: if isAdmin() || isRedeemStudentAccessCreate();
      allow update: if isAdmin() || isInviteStudentAccessUpdate();
      allow delete: if isAdmin();
    }
    match /studentEntitlements/{uid}/items/{entitlementId} {
      allow read: if isAdmin() || (isSignedIn() && uid == request.auth.uid);
      allow create, update: if isAdmin() || isStudentEntitlementWrite(uid, entitlementId);
      allow delete: if isAdmin();
    }

    match /accessInvites/{docId} {
      allow read: if isAdmin() || isInviteOwnRecord();
      allow create: if isAdmin();
      allow update: if isAdmin() || isInviteOpenUpdate(docId) || isInviteRedeemUpdate(docId);
      allow delete: if isAdmin();
    }

    match /accessAuditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isRedeemAuditCreate() || isInviteOpenAuditCreate() || isInviteRedeemAuditCreate();
      allow update, delete: if false;
    }

    /* ================================
       Access Engine — Future Admin Workflows
       ================================ */

    match /accessBulkImports/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessBulkImportRows/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessEmailQueue/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessNotifications/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /accessPlanHistory/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /accessActionLogs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
  }
}
