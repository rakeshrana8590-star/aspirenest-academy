rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email == "aspirenestplatform@gmail.com";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /intellibook/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /notes/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /currentAffairs/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /videos/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /mockTests/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /roadmaps/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /profiles/{uid}/{allPaths=**} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
